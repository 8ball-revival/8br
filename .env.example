# World Cue Championships (WCC) — environment variables
# (documented placeholders only; copy to .env and fill in)

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Runtime connection used by Prisma AND Payload. On Neon, use the POOLED
# connection string and keep the SSL parameter.
# Local dev uses the bundled pgserver PostgreSQL on fixed port 54329 (see README).
#   Local:  postgresql://postgres@127.0.0.1:54329/wcc
#   Neon:   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/wcc

# Direct (unpooled) connection, used ONLY for migrations (scripts/deploy-migrate.mjs).
# Prisma's migrate engine needs advisory locks that a pooled/PgBouncer endpoint
# can't provide. On Neon, use the DIRECT connection string. Optional locally /
# when DATABASE_URL is already a direct connection (the script falls back to
# DATABASE_URL if this is unset).
#   Neon:   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=

# ---------------------------------------------------------------------------
# Payload CMS (required)
# ---------------------------------------------------------------------------
# Secret used by Payload to sign/encrypt tokens. Generate a long random value.
# e.g. (Node):  require('crypto').randomBytes(32).toString('hex')
PAYLOAD_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# First-owner setup gate (recommended for handover)
# ---------------------------------------------------------------------------
# When set, the one-time /setup page (which creates the first administrator/owner
# account, and only works while NO account exists) additionally requires this
# secret. Set it before the first deploy, use it once to create the owner, then
# it becomes irrelevant (setup self-disables once an owner exists). Leave unset
# to allow setup without a secret (only safe if you run /setup immediately).
SETUP_SECRET=

# ---------------------------------------------------------------------------
# Public site URL (recommended in production)
# ---------------------------------------------------------------------------
# Canonical/OpenGraph/sitemap URLs + Payload admin cookies/CORS/CSRF use this.
# Falls back to http://localhost:3000 for canonical URLs if unset.
#   Prod (cueverse.net):   https://cueverse.net
NEXT_PUBLIC_SITE_URL=https://cueverse.net

# Optional canonical-host redirect (www → apex) for the WCC domain.
# Set both to enable the redirect in next.config.ts (www.cueverse.net → cueverse.net).
WCC_WWW_HOST=www.cueverse.net
WCC_APEX_ORIGIN=https://cueverse.net

# ---------------------------------------------------------------------------
# Transactional email (optional — password-reset links)
# ---------------------------------------------------------------------------
# When RESEND_API_KEY is set, Payload sends real email via Resend. Without it,
# Payload logs emails to the console (dev still works). RESEND_FROM_EMAIL must be
# a verified Resend sender/domain in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cueverse.net

# ---------------------------------------------------------------------------
# Media uploads on Vercel (optional)
# ---------------------------------------------------------------------------
# Vercel's filesystem is read-only/ephemeral, so media uploads go to Vercel Blob.
# Create a Vercel Blob store (Storage tab) and this is set automatically. When
# unset, media uploads are simply unavailable; the app still builds and runs.
BLOB_READ_WRITE_TOKEN=
