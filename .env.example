# 8 Ball Registry (8BR) — environment variables
# (documented placeholders only; copy to .env and fill in)

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Runtime connection used by Prisma AND Payload. On Neon, use the POOLED
# connection string and keep the SSL parameter.
# Local dev uses the bundled pgserver PostgreSQL on fixed port 54329 (see README).
#   Local:  postgresql://postgres@127.0.0.1:54329/8br
#   Neon:   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/8br

# Direct (unpooled) connection, used ONLY for migrations (scripts/deploy-migrate.mjs).
# Prisma's migrate engine needs advisory locks that a pooled/PgBouncer endpoint
# can't provide. On Neon, use the DIRECT connection string. Optional locally /
# when DATABASE_URL is already a direct connection (the script falls back to
# DATABASE_URL if this is unset).
#   Neon:   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=

# ---------------------------------------------------------------------------
# Payload CMS (required)
# ---------------------------------------------------------------------------
# Secret used by Payload to sign/encrypt tokens. Generate a long random value.
# e.g. (Node):  require('crypto').randomBytes(32).toString('hex')
PAYLOAD_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# First-owner setup gate (recommended for handover)
# ---------------------------------------------------------------------------
# When set, the one-time /setup page (which creates the first administrator/owner
# account, and only works while NO account exists) additionally requires this
# secret. Set it before the first deploy, use it once to create the owner, then
# it becomes irrelevant (setup self-disables once an owner exists). Leave unset
# to allow setup without a secret (only safe if you run /setup immediately).
SETUP_SECRET=

# ---------------------------------------------------------------------------
# Break-glass recovery console (optional — leave BOTH blank to disable)
# ---------------------------------------------------------------------------
# An env-gated operator credential for /recovery: a private console that can transfer
# ownership away from a rogue platform Owner to a chosen good account (demoting the
# rogue Owner to Administrator). It is NOT a row in the users table, so it never appears
# in /users, the Staff list, or the Payload /admin UI. EVERY action it performs is written
# to the audit log. The whole feature is INERT (the /recovery route returns 404) unless
# BOTH variables below are set and non-empty. The session cookie is signed with PAYLOAD_SECRET
# above (no separate secret is required).
#
# RECOVERY_USERNAME — the operator login name (e.g. neo).
RECOVERY_USERNAME=
# RECOVERY_PASSWORD_HASH — scrypt hash "<saltHex>:<hashHex>" (16-byte salt, 64-byte key).
# The plaintext password is NEVER stored. Generate with (replace PASSWORD):
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('PASSWORD',s,64).toString('hex'))"
RECOVERY_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Public site URL (recommended in production)
# ---------------------------------------------------------------------------
# Canonical/OpenGraph/sitemap URLs + Payload admin cookies/CORS/CSRF use this.
# Falls back to http://localhost:3000 for canonical URLs if unset.
#   Prod (8br.gg):   https://8br.gg
#
# *** LEAVE THIS UNSET IN LOCAL DEVELOPMENT. ***
#
# Setting it makes Payload emit ABSOLUTE media urls (http://localhost:3000/api/media/file/...).
# next/image treats an absolute url as REMOTE, so the dev server fetches the image back from
# itself while it is still rendering the page that asked for it — the request deadlocks, and every
# next/image asset (header logo, homepage hero) renders broken while the raw file serves fine on
# its own. It is a confusing failure because the file is demonstrably there.
#
# Unset, Payload emits RELATIVE paths, the `localPatterns` entry in next.config.ts covers them, no
# remote fetch happens, and src/lib/site.ts still falls back to http://localhost:3000 for canonical
# urls — so nothing else changes.
#
# In production this MUST be set: it is what makes remotePatterns allow the site's own media route,
# and canonical urls, the sitemap and secure cookies all derive from it.
NEXT_PUBLIC_SITE_URL=https://8br.gg

# Optional canonical-host redirect (www → apex) for the 8BR domain.
# Set both to enable the redirect in next.config.ts (www.cueverse.net → cueverse.net).
SITE_WWW_HOST=www.cueverse.net
SITE_APEX_ORIGIN=https://cueverse.net

# ---------------------------------------------------------------------------
# Transactional email (optional — password-reset links)
# ---------------------------------------------------------------------------
# When RESEND_API_KEY is set, Payload sends real email via Resend. Without it,
# Payload logs emails to the console (dev still works). RESEND_FROM_EMAIL must be
# a verified Resend sender/domain in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cueverse.net

# ---------------------------------------------------------------------------
# Media uploads on Vercel (optional)
# ---------------------------------------------------------------------------
# Vercel's filesystem is read-only/ephemeral, so media uploads go to Vercel Blob.
# Create a Vercel Blob store (Storage tab) and this is set automatically. When
# unset, media uploads are simply unavailable; the app still builds and runs.
BLOB_READ_WRITE_TOKEN=
