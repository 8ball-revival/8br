# 8 Ball Revival — environment variables (documented placeholders only; copy to .env and fill in)

# PostgreSQL connection string used by both Next.js and Payload CMS.
# Local dev uses the bundled pgserver PostgreSQL on fixed port 54329 (see README).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/ego

# Secret used by Payload to sign/encrypt tokens. Generate a long random value.
# e.g. (Node):  require('crypto').randomBytes(32).toString('hex')
PAYLOAD_SECRET=replace-with-a-long-random-secret
