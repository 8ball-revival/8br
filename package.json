{
  "name": "8-ball-registry",
  "version": "0.1.0",
  "description": "8 Ball Registry (8BR) \u2014 a standalone tournament platform for competitive cue sports.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:replica": "node scripts/dev-replica.mjs",
    "reset:organization": "tsx scripts/reset-organization.mts",
    "test:tournament-isolation": "tsx scripts/test-cup-isolation.mts",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack && node scripts/postbuild-cjs.mjs",
    "vercel-build": "node scripts/deploy-migrate.mjs && npm run build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "archive:stage": "node scripts/archive/stage.mjs",
    "archive:validate": "node scripts/archive/validate.mjs",
    "archive:report": "node scripts/archive/report.mjs",
    "archive:context": "node scripts/archive/context.mjs",
    "archive:apply-policies": "node scripts/archive/apply-policies.mjs",
    "archive:apply-reviews": "node scripts/archive/apply-reviews.mjs",
    "archive:review-packet": "node scripts/archive/packets.mjs",
    "archive:review-test": "node scripts/archive/test-decisions.mjs",
    "archive:import": "node scripts/archive/import.mjs",
    "test:site-builder": "tsx --tsconfig tsconfig.scripts.json scripts/verify-site-builder.mts",
    "test:site-builder:db": "tsx --tsconfig tsconfig.scripts.json scripts/verify-site-builder-db.mts",
    "site-builder:bootstrap": "tsx --tsconfig tsconfig.scripts.json scripts/site-builder-bootstrap.mts",
    "test:dev-hydration": "node scripts/verify-dev-hydration.mjs",
    "test:responsive": "node scripts/verify-responsive.mjs",
    "capture:site-builder": "tsx --tsconfig tsconfig.scripts.json scripts/capture-site-builder-proof.mts",
    "test:site-builder:security": "tsx --tsconfig tsconfig.scripts.json scripts/verify-site-builder-security.mts",
    "test:site-builder:scheduler": "tsx --tsconfig tsconfig.scripts.json scripts/verify-site-builder-scheduler.mts",
    "test:site-builder:integration": "tsx --tsconfig tsconfig.scripts.json scripts/verify-site-builder-integration.mts",
    "cleanup:verification-sessions": "tsx --tsconfig tsconfig.scripts.json scripts/cleanup-verification-sessions.mts",
    "apply:homepage-record": "tsx --tsconfig tsconfig.scripts.json scripts/apply-homepage-record-row.mts",
    "apply:graphite-homepage": "tsx --tsconfig tsconfig.scripts.json scripts/apply-graphite-homepage.mts",
    "test:homepage": "tsx --tsconfig tsconfig.scripts.json scripts/verify-homepage-graphite.mts",
    "test:homepage:edit": "tsx --tsconfig tsconfig.scripts.json scripts/verify-homepage-editmode.mts",
    "test:theme": "tsx --tsconfig tsconfig.scripts.json scripts/verify-theme-system.mts",
    "test:theme:publish": "tsx --tsconfig tsconfig.scripts.json scripts/verify-theme-publish.mts",
    "test:theme:permissions": "tsx --tsconfig tsconfig.scripts.json scripts/verify-theme-permissions.mts",
    "test:theme:lifecycle": "tsx --tsconfig tsconfig.scripts.json scripts/verify-theme-lifecycle-ui.mts",
    "player:find": "tsx --tsconfig tsconfig.scripts.json scripts/player-find.mts",
    "test:player-picker": "tsx --tsconfig tsconfig.scripts.json scripts/verify-player-picker.mts",
    "test:player-picker:ui": "tsx --tsconfig tsconfig.scripts.json scripts/verify-player-picker-ui.mts",
    "test:typography": "tsx --tsconfig tsconfig.scripts.json scripts/verify-typography.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-resend": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-vercel-blob": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^0.475.0",
    "next": "16.2.6",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "type": "module"
}
