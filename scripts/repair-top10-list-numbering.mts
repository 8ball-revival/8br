// RETIRED — see scripts/_retired.mjs. Importing this file refuses to run.
import './_retired.mjs'

/**
 * Number the ten one-item lists in the migrated "Top 10 Active CueVerse Players" post.
 *
 * ── What is wrong with it ────────────────────────────────────────────────────────────────────────
 * Its body holds ten ordered lists, each containing exactly one item, with a paragraph of commentary
 * between them. That is what the migration made of a ranking whose items each had prose attached.
 * Ten separate lists is ten separate `<ol>` elements, and every ordered list restarts at 1, so the
 * page reads "1." ten times. The digits are generated by the list markup, which is why they cannot
 * be edited out of the text — there are no digits in the text.
 *
 * ── What this changes ────────────────────────────────────────────────────────────────────────────
 * The `start` of each ordered list, in document order, to 1 through 10. Nothing else. No wording, no
 * commentary, no paragraph, no emphasis, no ordering, and no other post.
 *
 * A start of 1 is stored as absent, because that is the default — so the first list is left exactly
 * as it is and only nine blocks actually change.
 *
 * Usage: tsx scripts/repair-top10-list-numbering.mts [--apply]
 */
import { prisma } from '../src/lib/prisma.ts'
import { assertLocalDatabase } from '../src/lib/db-guard.ts'

assertLocalDatabase()

const APPLY = process.argv.includes('--apply')
const SLUG = 'top-10-active-cueverse-players-3-new-players'

const post = await prisma.breakPost.findFirst({
  where: { slug: SLUG },
  select: { id: true, title: true, body: true, bodyText: true },
})
if (!post) { console.log(`No post at ${SLUG}.`); await prisma.$disconnect(); process.exit(1) }

interface Block { t: string; items?: unknown[]; start?: number; [k: string]: unknown }
const doc = post.body as unknown as { v: number; blocks: Block[] }
const blocks = doc.blocks ?? []

const ordered = blocks.map((b, i) => ({ b, i })).filter(({ b }) => b.t === 'ol')
console.log(`${post.title}`)
console.log(`  ${blocks.length} blocks, ${ordered.length} ordered list(s)`)

const multi = ordered.filter(({ b }) => (b.items?.length ?? 0) !== 1)
if (multi.length) {
  console.log(`  REFUSED: ${multi.length} of them hold more than one item — this is not the shape this repairs`)
  await prisma.$disconnect(); process.exit(1)
}

/*
 * The wording is compared before and after, in full.
 *
 * The only safe claim this script can make is that it changed numbering and nothing else, and the
 * way to be able to make it is to serialise every piece of text in the document both ways and
 * require them to be identical.
 */
const textOf = (d: unknown): string => JSON.stringify(d, (k, v) => (k === 'start' ? undefined : v))
const before = textOf(doc)

const repaired = {
  ...doc,
  blocks: blocks.map((b) => {
    if (b.t !== 'ol') return b
    const n = ordered.findIndex((o) => o.b === b) + 1
    // 1 is the default and is stored as absent, so the first list is returned untouched.
    return n <= 1 ? b : { ...b, start: n }
  }),
}

const after = textOf(repaired)
console.log(`  wording identical: ${before === after ? 'yes' : 'NO'}`)
if (before !== after) {
  console.log('  REFUSED: something other than the numbering would change')
  await prisma.$disconnect(); process.exit(1)
}

for (const { b } of ordered) {
  const n = ordered.findIndex((o) => o.b === b) + 1
  const label = JSON.stringify(b.items?.[0]).slice(0, 60)
  console.log(`    ${String(n).padStart(2)}. ${label}`)
}

if (!APPLY) {
  console.log('\nDRY RUN — nothing changed. Re-run with --apply.')
  await prisma.$disconnect(); process.exit(0)
}

await prisma.breakPost.update({
  where: { id: post.id },
  // bodyText is untouched: no wording changed, so the plain-text projection cannot have.
  data: { body: repaired as never },
})
console.log('\nrepaired — the ten lists now start at 1 through 10')

const check = await prisma.breakPost.findUnique({ where: { id: post.id }, select: { body: true, bodyText: true } })
const got = (check?.body as unknown as { blocks: Block[] }).blocks.filter((b) => b.t === 'ol').map((b) => b.start ?? 1)
console.log(`  starts now: ${got.join(', ')}`)
console.log(`  bodyText unchanged: ${check?.bodyText === post.bodyText ? 'yes' : 'NO'}`)

await prisma.$disconnect()
