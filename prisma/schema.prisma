// ============================================================================
// 8 Ball Registry (8BR) · Competition data model (Prisma)
// ----------------------------------------------------------------------------
// Prisma is the SCHEMA AUTHORITY for the competition / records / identity core.
// It owns the DEFAULT ("public") PostgreSQL schema. Payload CMS owns a SEPARATE
// "payload" schema (auth, Users, Media, News, Rules) and never touches these
// tables. The two layers connect only by application-level IDs (e.g. a *ByUserId
// string points at a Payload user); there are intentionally NO cross-ORM foreign
// keys. See DATA_MODEL.md for full documentation, the ER diagram, and rationale.
//
// This file defines the schema only. No data (historical or otherwise) is seeded.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ----------------------------------------------------------------------------
// Enums are used ONLY for dimensions that are conceptually fixed. Genuinely
// extensible dimensions (competition type, stage format, match format, ranking
// system) are LOOKUP TABLES instead, so new variants are added as rows — never
// a migration. This is the primary "future formats without schema redesign"
// mechanism. See DATA_MODEL.md §Scalability.
// ============================================================================

/// Distinguishes imported legacy records from records created natively in 8BR.
/// Required on every primary entity so the two are always separable.
enum Provenance {
  IMPORTED_LEGACY
  NATIVE
}

/// A Competitor is a Player now; Team support is future. The supertype lets all
/// competitive references (matches, standings, seeds, championships, rankings,
/// head-to-head) point at one identity type without a later redesign.
enum CompetitorType {
  PLAYER
  TEAM
}

/// The kind of raw identifier an alias represents.
enum AliasType {
  HANDLE
  YAHOO_MESSENGER
  EMAIL
  FORUM
  OTHER
}

enum CompetitionStatus {
  UPCOMING
  REGISTRATION_OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

/// Which structural family a stage format belongs to. Drives whether a stage
/// hangs Groups, Brackets, or a single decisive Match off it. New StageFormat
/// rows pick one of these families; the app needs no new code paths per format.
enum StageFormatFamily {
  GROUP_BASED // round robin, swiss, pools, group stage
  BRACKET_BASED // single/double elimination
  SINGLE_MATCH // a one-off final / decider
  HYBRID // custom combinations, config-driven
}

enum BracketType {
  MAIN
  WINNERS
  LOSERS
  CONSOLATION
  FINALS
}

/// Lifecycle state of a fixture. HOW a completed match was decided (played,
/// forfeit, bye, admin decision, ...) is captured separately by MatchResolution
/// on MatchResult, so status stays a clean lifecycle. Disputes are tracked via
/// IssueReport (targetType = MATCH / MATCH_RESULT), not a status value.
enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
  VOID
}

/// HOW a match result came about. Separates the outcome method from the lifecycle
/// status and from the score, so forfeits, walkovers, byes, retirements, double
/// forfeits, and administrative rulings are all first-class and distinguishable.
enum MatchResolution {
  PLAYED
  WALKOVER
  FORFEIT
  DOUBLE_FORFEIT
  BYE
  RETIREMENT
  ADMIN_DECISION
}

/// How a competition admits entrants (POLICY_FRAMEWORK.md §1). OPEN = public
/// entry (admin confirms unless auto-accept); APPROVAL_REQUIRED = entry requests
/// admins approve/decline; INVITATIONAL = no public registration, admins add
/// players; QUALIFICATION_ONLY = entry earned via another competition/ranking.
enum RegistrationMode {
  OPEN
  APPROVAL_REQUIRED
  INVITATIONAL
  QUALIFICATION_ONLY
}

/// How a competitor came to be in a competition — public sign-up, admin invite,
/// admin add, qualification from a prior stage, or direct seeding.
enum EntryMethod {
  PUBLIC_REGISTRATION
  ADMIN_INVITE
  ADMIN_ADDED
  QUALIFIED
  SEEDED
}

/// How a competitor's seed position was derived (POLICY_FRAMEWORK.md §2). UNKNOWN
/// preserves historical seeds whose method/position is undocumented — never inferred.
enum SeedingMethod {
  MANUAL
  RANDOM_DRAW
  GLOBAL_RANKING
  COMPETITION_STANDING
  PREVIOUS_STAGE
  PREVIOUS_SEASON
  QUALIFICATION_ORDER
  HYBRID
  UNKNOWN
}

/// State of the link between a Payload user account and a canonical Player. The
/// account never OWNS the historical identity; it merely claims/links to it.
/// PENDING = claim submitted; VERIFIED = admin-approved; REJECTED = admin-declined
/// claim; REVOKED = a previously verified link removed.
enum PlayerLinkStatus {
  UNLINKED
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

/// Which outcome of a source match fills a downstream match slot for live-bracket
/// progression — the winner (advance / grand final) or the loser (losers-bracket
/// drop). See POLICY_FRAMEWORK.md §11.
enum MatchSlotSource {
  WINNER
  LOSER
}

enum MatchFormatKind {
  RACE_TO // first to N racks/games (standard pool)
  BEST_OF // best of N games
}

/// How much we trust a recorded result / champion. Mirrors the archive's
/// confidence signals (explicit label vs heuristic reconstruction).
enum RecordConfidence {
  EXPLICIT
  HEURISTIC_LABEL
  HEURISTIC_COUNT
  RECONSTRUCTED
  UNKNOWN
}

enum EntryStatus {
  REGISTERED
  CONFIRMED
  DECLINED // admin declined an entry request (distinct from player WITHDRAWN)
  WAITLISTED
  WITHDRAWN
  DISQUALIFIED
  NO_SHOW
}

enum CorrectionStatus {
  PROPOSED
  APPROVED
  APPLIED
  REJECTED
  REVERTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IssueStatus {
  OPEN
  TRIAGED
  IN_REVIEW
  RESOLVED
  REJECTED
  DUPLICATE
}

enum SourceKind {
  FILE_ROW // e.g. "playoffs.csv:88"
  URL
  WAYBACK
  MANUAL_REVIEW
  IMPORT_JOB
  OTHER
}

/// Polymorphic target discriminator for cross-cutting entities (SourceReference,
/// HistoricalCorrection, IssueReport). Relational DBs cannot express a single FK
/// to "any table", so we pair (targetType, targetId) and enforce integrity in
/// the application + import layer. New target kinds = new enum value only.
enum RecordType {
  PLAYER
  PLAYER_ALIAS
  TEAM
  COMPETITOR
  COMPETITION
  DIVISION
  STAGE
  GROUP
  BRACKET
  MATCH
  MATCH_RESULT
  STANDING_ROW
  SEED
  COMPETITION_ENTRY
  CHAMPIONSHIP
  ACHIEVEMENT
  RANKING_SNAPSHOT
  RANKING_SNAPSHOT_ITEM
  HALL_OF_FAME_ENTRY
  HEAD_TO_HEAD
  PLAYER_MERGE
  PLAYER_SPLIT
  HISTORICAL_CORRECTION // lets multiple SourceReferences attach to one correction
}

// ============================================================================
// IDENTITY & PARTICIPANTS
// ============================================================================

/// Canonical human competitor. Aliases resolve up to exactly one Player.
/// Preserves the stable legacy id (e.g. "P1316") for traceability across the
/// import. A Player is fronted by exactly one Competitor for all competitive refs.
model Player {
  id                   String           @id @default(cuid())
  legacyPlayerId       String?          @unique // e.g. "P1316" from the 8BRCAM archive
  primaryName          String
  country              String?
  firstYear            Int?
  lastYear             Int?
  primaryYm            String? // primary Yahoo Messenger id (identity signal)
  primaryEmail         String? // primary email (identity signal)
  // Public current-identity fields (safe to display): competitive handle, Discord,
  // and time zone. Email is NEVER stored here (it lives only on the Payload account).
  cueverseId           String? // public competitive handle (e.g. "Starkiller") — the site-wide default display identity (preserves casing)
  // Case-insensitive canonical form of cueverseId (trim + lowercase = cueverseLoginKey). This is the
  // authoritative uniqueness key for account identity: a UNIQUE index enforces that no two players can
  // hold the same CueVerse ID regardless of casing. Written ONLY by the central identity service, which
  // also mirrors it to the Payload auth `username` (the login projection). Nullable for archive/backing
  // players that carry no CueVerse ID (Postgres treats NULLs as distinct, so many may be null).
  cueverseIdNormalized String?          @unique
  cueverseIdChangedAt  DateTime? // last time the CueVerse ID changed (enforces the self-service cooldown)
  discord              String? // public contact (community norm — shown publicly)
  timeZone             String?
  active               Boolean          @default(true) // staff can mark a profile inactive
  /// Management-only account: a real login for running the site, not a competitor. Kept out of the
  /// member list and out of every entrant/free-agent selector, so it can never be added to a Season
  /// or Tournament by accident. Distinct from `active`, which hides a profile outright.
  managementOnly       Boolean          @default(false)
  /// Trusted Author: may publish their own articles without prior review. Server-enforced, set only
  /// by an owner/admin, and never inferred from competition activity or management-only status.
  /// Revoking it stops new publishing immediately but leaves already-published work standing.
  blogTrustedAuthor    Boolean          @default(false)
  // Account linking: a Payload user may CLAIM this canonical identity without
  // owning it. linkedUserId is an app-level ref to a Payload user (no cross-ORM FK).
  // @unique enforces one account ↔ at most one profile (both directions).
  linkedUserId         String?          @unique
  linkStatus           PlayerLinkStatus @default(UNLINKED)

  /// Editorial back-relations. All optional and all SetNull/Cascade on the owning side, so an
  /// archived author never takes published history down with them.
  authoredArticles Article[]         @relation("ArticleAuthor")
  reviewedArticles Article[]         @relation("ArticleReviewer")
  articleComments  ArticleComment[]  @relation("CommentAuthor")
  articleMentions  ArticleRelation[] @relation("ArticleRelatedPlayer")
  mediaUploads     MediaUpload[]     @relation("MediaUploader")

  // The Break. One sitewide community; see the section at the end of this file.
  breakPosts         BreakPost[]         @relation("BreakPostAuthor")
  breakComments      BreakComment[]      @relation("BreakCommentAuthor")
  breakPostVotes     BreakPostVote[]     @relation("BreakPostVoter")
  breakCommentVotes  BreakCommentVote[]  @relation("BreakCommentVoter")
  breakPollVotes     BreakPollVote[]     @relation("BreakPollVoter")
  breakSavedPosts    BreakSavedPost[]    @relation("BreakSavedPosts")
  breakSavedComments BreakSavedComment[] @relation("BreakSavedComments")
  breakHiddenPosts   BreakHiddenPost[]   @relation("BreakHiddenPosts")
  breakReports       BreakReport[]       @relation("BreakReporter")
  breakNotifications BreakNotification[] @relation("BreakNotificationRecipient")
  breakKarma         BreakKarma?         @relation("BreakKarma")
  linkedAt           DateTime?
  provenance         Provenance          @default(NATIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  competitor        Competitor?
  aliases           PlayerAlias[]
  achievements      Achievement[]
  careerStat        PlayerCareerStat?
  seasonStats       PlayerSeasonStat[]
  hallOfFameEntries HallOfFameEntry[]
  teamMemberships   TeamMembership[]
  mergesAsCanonical PlayerMerge[]      @relation("MergeCanonical")
  mergesAsMerged    PlayerMerge[]      @relation("MergeMerged")
  splitsAsSource    PlayerSplit[]      @relation("SplitSource")
  splitsAsNew       PlayerSplit[]      @relation("SplitNew")

  @@index([primaryName])
  @@index([provenance])
  @@index([linkedUserId])
}

/// A raw identifier historically used by a player (handle / YM / email / forum).
/// NOT globally unique: the same raw handle can map to different canonical people
/// over time (see PlayerSplit). Uniqueness is only per (player, alias, type) to
/// prevent duplicate rows for the same player.
model PlayerAlias {
  id         String     @id @default(cuid())
  playerId   String
  alias      String
  aliasType  AliasType  @default(HANDLE)
  provenance Provenance @default(NATIVE)
  createdAt  DateTime   @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, alias, aliasType])
  @@index([alias])
  @@index([aliasType])
}

/// FUTURE: a team identity. Included now so the Competitor supertype and all
/// competitive references are team-ready without a schema redesign.
model Team {
  id         String     @id @default(cuid())
  legacyId   String?    @unique
  name       String
  tag        String?
  country    String?
  provenance Provenance @default(NATIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  competitor  Competitor?
  memberships TeamMembership[]

  @@index([name])
}

/// FUTURE: player membership in a team over time.
model TeamMembership {
  id       String    @id @default(cuid())
  teamId   String
  playerId String
  role     String?
  joinedAt DateTime?
  leftAt   DateTime?

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId, joinedAt])
  @@index([teamId])
  @@index([playerId])
}

/// SUPERTYPE that every competitive reference points to. Exactly one of
/// playerId / teamId is set (enforced by a CHECK added in the constraints
/// migration + the app layer). This is the key extensibility decision that
/// makes matches / standings / rankings / head-to-head team-ready today.
model Competitor {
  id        String         @id @default(cuid())
  type      CompetitorType @default(PLAYER)
  playerId  String?        @unique
  teamId    String?        @unique
  createdAt DateTime       @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  matchesAsA          Match[]               @relation("MatchCompetitorA")
  matchesAsB          Match[]               @relation("MatchCompetitorB")
  matchesWon          MatchResult[]         @relation("MatchWinner")
  standings           StandingRow[]
  seeds               Seed[]
  entries             CompetitionEntry[]
  championshipsWon    Championship[]        @relation("ChampionshipChampion")
  championshipsRunner Championship[]        @relation("ChampionshipRunnerUp")
  rankingItems        RankingSnapshotItem[]
  headToHeadAsLo      HeadToHead[]          @relation("H2HLo")
  headToHeadAsHi      HeadToHead[]          @relation("H2HHi")

  @@index([type])
}

// ============================================================================
// COMPETITION STRUCTURE
// ----------------------------------------------------------------------------
// Season / Cup / Tournament are NOT separate tables — they are Competition rows
// discriminated by CompetitionType. This is the "common underlying competition
// model" the brief requires. A Competition owns an ordered set of Stages; each
// Stage has a format and, by that format's family, hangs Groups and/or Brackets.
// ============================================================================

/// LOOKUP TABLE — the competition category (SEASON, CUP, TOURNAMENT, and any
/// future kind). A row, not an enum, so new categories need no migration.
model CompetitionType {
  id          String  @id @default(cuid())
  code        String  @unique // SEASON | CUP | TOURNAMENT | ...
  name        String
  description String?
  sortOrder   Int     @default(0)

  competitions Competition[]
}

/// A single competition instance (one season edition, one cup, one tournament).
model Competition {
  id                String            @id @default(cuid())
  competitionTypeId String
  legacyId          String?           @unique // e.g. "2010-s1"
  slug              String            @unique
  name              String
  edition           String? // free-form edition label
  year              Int?
  period            String? // e.g. "S1" / "Winter"
  era               String? // legacy era label carried from the archive
  status            CompetitionStatus @default(UPCOMING)
  registrationMode  RegistrationMode  @default(OPEN) // open / approval / invitational / qualification
  startDate         DateTime?
  endDate           DateTime?
  metadata          Json? // type-specific attributes without new columns
  provenance        Provenance        @default(NATIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  competitionType CompetitionType    @relation(fields: [competitionTypeId], references: [id])
  divisions       Division[]
  stages          Stage[]
  entries         CompetitionEntry[]
  matches         Match[]
  championships   Championship[]
  achievements    Achievement[]
  seasonStats     PlayerSeasonStat[]

  @@index([competitionTypeId])
  @@index([status])
  @@index([year])
}

/// Optional structural split within a competition (e.g. Division A / B). In the
/// archive, each season division has its own groups and playoff. Stages/Groups
/// may be division-scoped or competition-wide (divisionId null).
model Division {
  id            String     @id @default(cuid())
  competitionId String
  legacyId      String?    @unique
  code          String // "A", "B", ...
  name          String?
  sortOrder     Int        @default(0)
  provenance    Provenance @default(NATIVE)

  competition   Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  stages        Stage[]
  groups        Group[]
  entries       CompetitionEntry[]
  matches       Match[]
  championships Championship[]

  @@unique([competitionId, code])
  @@index([competitionId])
}

/// LOOKUP TABLE — a stage format (GROUP, ROUND_ROBIN, SWISS, SINGLE_ELIM,
/// DOUBLE_ELIM, POOL, FINALS, ...). Each format declares a family so the app
/// knows how to render/compute it. New formats = new rows, no migration.
model StageFormat {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  family       StageFormatFamily
  description  String?
  configSchema Json? // optional JSON-schema describing this format's config

  stages Stage[]
}

/// An ordered phase of a competition. Format-agnostic: a competition can freely
/// combine stages of different formats (groups, swiss, brackets, finals). The
/// `config` JSON holds format-specific parameters (swiss rounds, tiebreakers,
/// bracket size) so new formats need no new columns.
model Stage {
  id            String     @id @default(cuid())
  competitionId String
  divisionId    String?
  stageFormatId String
  legacyId      String?    @unique
  name          String
  sequence      Int // ordering within the competition
  config        Json?
  provenance    Provenance @default(NATIVE)
  createdAt     DateTime   @default(now())

  competition   Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  division      Division?      @relation(fields: [divisionId], references: [id])
  format        StageFormat    @relation(fields: [stageFormatId], references: [id])
  groups        Group[]
  brackets      Bracket[]
  matches       Match[]
  seeds         Seed[]
  championships Championship[]

  @@unique([competitionId, sequence, divisionId])
  @@index([competitionId])
  @@index([divisionId])
  @@index([stageFormatId])
}

/// A group / pool within a GROUP_BASED stage. Round-robin and swiss both use
/// Groups (a swiss "group" is the whole field). Standings hang off a Group.
model Group {
  id         String     @id @default(cuid())
  stageId    String
  divisionId String?
  legacyId   String?    @unique
  code       String // "A", "B", ...
  name       String?
  scoreModel String? // carried from the archive (points model)
  sortOrder  Int        @default(0)
  provenance Provenance @default(NATIVE)

  stage     Stage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  division  Division?     @relation(fields: [divisionId], references: [id])
  standings StandingRow[]
  matches   Match[]

  @@index([stageId])
  @@index([divisionId])
}

/// A bracket within a BRACKET_BASED stage. Double elimination uses two brackets
/// (WINNERS + LOSERS) under one stage; single elimination uses one (MAIN).
model Bracket {
  id         String      @id @default(cuid())
  stageId    String
  legacyId   String?     @unique
  type       BracketType @default(MAIN)
  name       String?
  size       Int?
  provenance Provenance  @default(NATIVE)

  stage   Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  matches Match[]
  seeds   Seed[]

  @@index([stageId])
}

/// A competitor's seeding into a stage/bracket (from the archive's playoff seeds).
model Seed {
  id             String        @id @default(cuid())
  stageId        String
  bracketId      String?
  competitorId   String
  seedNo         Int
  // How this seed was derived, and — if seedNo is a manual override — the original
  // calculated/proposed seed (never erased). POLICY_FRAMEWORK.md §2.
  seedingMethod  SeedingMethod @default(UNKNOWN)
  proposedSeedNo Int?
  handle         String? // raw handle recorded in the source, if unresolved
  provenance     Provenance    @default(NATIVE)

  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  bracket    Bracket?   @relation(fields: [bracketId], references: [id])
  competitor Competitor @relation(fields: [competitorId], references: [id])

  @@unique([stageId, competitorId])
  @@index([stageId])
  @@index([bracketId])
  @@index([competitorId])
}

/// A competitor's participation / registration in a competition (also powers
/// per-competition tournament registration for live 8 Ball Registry events).
model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  divisionId    String?
  competitorId  String
  seed          Int?
  status        EntryStatus @default(REGISTERED)
  entryMethod   EntryMethod @default(PUBLIC_REGISTRATION) // how they got in
  statusReason  String? // e.g. reason for withdrawal / disqualification
  registeredAt  DateTime?
  provenance    Provenance  @default(NATIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  division    Division?   @relation(fields: [divisionId], references: [id])
  competitor  Competitor  @relation(fields: [competitorId], references: [id])

  @@unique([competitionId, competitorId, divisionId])
  @@index([competitionId])
  @@index([competitorId])
  @@index([status])
}

// ============================================================================
// MATCHES, RESULTS & FORMAT
// ============================================================================

/// LOOKUP TABLE — the match format, encapsulating race length. "Race Length" is
/// represented as `raceLength` here rather than a separate table: it is a simple
/// integer attribute of a format, and normalizing it further would add joins
/// without value. New formats (Race to 9, Best of 11) = new rows.
model MatchFormat {
  id          String          @id @default(cuid())
  code        String          @unique // e.g. "RACE_TO_7"
  name        String // e.g. "Race to 7"
  kind        MatchFormatKind @default(RACE_TO)
  raceLength  Int // target games (race to N) or series length (best of N)
  description String?

  matches Match[]
}

/// The central competitive event: a contest between two competitors within a
/// stage, optionally located in a Group (group play) or Bracket (elimination).
/// `competitionId` and `divisionId` are DENORMALIZED from the stage for fast,
/// index-friendly filtering on the read-heavy public site.
model Match {
  id                 String           @id @default(cuid())
  legacyMatchId      String?          @unique
  competitionId      String
  divisionId         String?
  stageId            String
  groupId            String?
  bracketId          String?
  matchFormatId      String?
  bracketType        BracketType? // for double-elim disambiguation
  round              Int?
  roundName          String?
  matchNo            Int?
  // Competitor slots are NULLABLE to support byes (one side empty) and not-yet-
  // determined bracket fixtures (both empty until feeders resolve).
  competitorAId      String?
  competitorBId      String?
  // Raw handle/alias each competitor appeared under IN THIS match — preserves the
  // source display and ties alias usage to a specific historical match.
  competitorAHandle  String?
  competitorBHandle  String?
  // Live-bracket progression (POLICY_FRAMEWORK.md §11): which prior match's outcome
  // fills each slot. slotASource = WINNER/LOSER of slotASourceMatch, etc. NULL for
  // imported static brackets (competitors set directly). A grand-final reset is a
  // second finals match sourced from the first (WINNER + LOSER).
  slotASourceMatchId String?
  slotASource        MatchSlotSource?
  slotBSourceMatchId String?
  slotBSource        MatchSlotSource?
  status             MatchStatus      @default(SCHEDULED)
  scheduledAt        DateTime?
  provenance         Provenance       @default(NATIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  competition          Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  division             Division?      @relation(fields: [divisionId], references: [id])
  stage                Stage          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group                Group?         @relation(fields: [groupId], references: [id])
  bracket              Bracket?       @relation(fields: [bracketId], references: [id])
  matchFormat          MatchFormat?   @relation(fields: [matchFormatId], references: [id])
  competitorA          Competitor?    @relation("MatchCompetitorA", fields: [competitorAId], references: [id])
  competitorB          Competitor?    @relation("MatchCompetitorB", fields: [competitorBId], references: [id])
  slotASourceMatch     Match?         @relation("MatchSlotASource", fields: [slotASourceMatchId], references: [id])
  slotBSourceMatch     Match?         @relation("MatchSlotBSource", fields: [slotBSourceMatchId], references: [id])
  feedsAsSlotASource   Match[]        @relation("MatchSlotASource")
  feedsAsSlotBSource   Match[]        @relation("MatchSlotBSource")
  result               MatchResult?
  championshipsDecided Championship[] @relation("ChampionshipDecidingMatch")

  @@index([competitionId])
  @@index([stageId])
  @@index([groupId])
  @@index([bracketId])
  @@index([competitorAId])
  @@index([competitorBId])
  @@index([competitionId, round])
  @@index([status])
  @@index([slotASourceMatchId])
  @@index([slotBSourceMatchId])
}

/// The OUTCOME of a match, split from Match so a fixture can exist before it is
/// played (upcoming events) and so the result carries its own audit/provenance/
/// confidence independently of the pairing.
model MatchResult {
  id                 String           @id @default(cuid())
  matchId            String           @unique
  // NULLABLE so a known result with an UNKNOWN score (common in the archive) is
  // distinct from a genuine 0-0. Pair a null score with confidence = UNKNOWN.
  scoreA             Int?
  scoreB             Int?
  isDraw             Boolean          @default(false)
  resolution         MatchResolution  @default(PLAYED) // played / forfeit / bye / admin ...
  winnerCompetitorId String?
  scoreModel         String? // carried from archive
  confidence         RecordConfidence @default(EXPLICIT)
  enteredByUserId    String? // app-level ref to a Payload user
  verifiedByUserId   String?
  verifiedAt         DateTime?
  provenance         Provenance       @default(NATIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  match  Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winner Competitor? @relation("MatchWinner", fields: [winnerCompetitorId], references: [id])

  @@index([winnerCompetitorId])
  @@index([confidence])
}

// ============================================================================
// STANDINGS & HEAD-TO-HEAD (derived / recomputed)
// ============================================================================

/// A competitor's row within a group's standings. Derived — regenerated from
/// matches so corrections propagate; never hand-edited.
model StandingRow {
  id           String     @id @default(cuid())
  groupId      String
  competitorId String
  slot         Int?
  played       Int        @default(0)
  wins         Int        @default(0)
  losses       Int        @default(0)
  draws        Int        @default(0)
  gamesFor     Int        @default(0)
  gamesAgainst Int        @default(0)
  winPct       Float?
  points       Float?
  bonus        Float?
  total        Float?
  rank         Int?
  provenance   Provenance @default(NATIVE)

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  competitor Competitor @relation(fields: [competitorId], references: [id])

  @@unique([groupId, competitorId])
  @@index([groupId])
  @@index([competitorId])
}

/// Pairwise all-time record between two competitors. Stored with a canonical
/// ordering (lo < hi) so each pair has exactly one row. Derived / recomputed.
model HeadToHead {
  id                String  @id @default(cuid())
  competitorLoId    String
  competitorHiId    String
  matches           Int     @default(0)
  loWins            Int     @default(0)
  hiWins            Int     @default(0)
  draws             Int     @default(0)
  loGames           Int     @default(0)
  hiGames           Int     @default(0)
  groupMatches      Int     @default(0)
  playoffMatches    Int     @default(0)
  lastCompetitionId String?

  competitorLo Competitor @relation("H2HLo", fields: [competitorLoId], references: [id])
  competitorHi Competitor @relation("H2HHi", fields: [competitorHiId], references: [id])

  @@unique([competitorLoId, competitorHiId])
  @@index([competitorLoId])
  @@index([competitorHiId])
}

// ============================================================================
// RECORDS, ACCOMPLISHMENTS, RANKINGS
// ============================================================================

/// A competition/division championship result (champion + runner-up), carrying
/// the archive's confidence and reconstruction flags.
model Championship {
  id                   String           @id @default(cuid())
  legacyId             String?          @unique
  competitionId        String
  divisionId           String?
  stageId              String? // the stage that decided the title
  decidedByMatchId     String? // the specific championship-deciding match
  championCompetitorId String?
  runnerUpCompetitorId String?
  championHandle       String? // raw handle if identity unresolved
  confidence           RecordConfidence @default(EXPLICIT)
  bracketReconstructed Boolean          @default(false)
  note                 String?
  provenance           Provenance       @default(NATIVE)
  createdAt            DateTime         @default(now())

  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  division       Division?   @relation(fields: [divisionId], references: [id])
  stage          Stage?      @relation(fields: [stageId], references: [id])
  decidedByMatch Match?      @relation("ChampionshipDecidingMatch", fields: [decidedByMatchId], references: [id])
  champion       Competitor? @relation("ChampionshipChampion", fields: [championCompetitorId], references: [id])
  runnerUp       Competitor? @relation("ChampionshipRunnerUp", fields: [runnerUpCompetitorId], references: [id])

  @@index([competitionId])
  @@index([championCompetitorId])
  @@index([stageId])
  @@index([decidedByMatchId])
}

/// A notable accomplishment attached to a player (from the archive's coded
/// achievements). Kept at the Player level (identity), optionally scoped to a
/// competition/division.
model Achievement {
  id            String     @id @default(cuid())
  legacyId      String?    @unique
  playerId      String
  code          String
  label         String
  competitionId String?
  divisionCode  String?
  value         String?
  provenance    Provenance @default(NATIVE)
  createdAt     DateTime   @default(now())

  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  competition Competition? @relation(fields: [competitionId], references: [id])

  @@index([playerId])
  @@index([code])
}

/// LOOKUP TABLE — a defined ranking methodology (all-time wins, ELO, season
/// points, ...). `config` holds algorithm parameters. New systems = new rows.
model RankingSystem {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  config      Json?

  snapshots RankingSnapshot[]
}

/// A point-in-time ranking under a system (header row).
model RankingSnapshot {
  id              String     @id @default(cuid())
  rankingSystemId String
  label           String
  asOf            DateTime
  scope           String? // e.g. "all-time", a competition slug, a category
  note            String?
  provenance      Provenance @default(NATIVE)
  createdAt       DateTime   @default(now())

  rankingSystem RankingSystem         @relation(fields: [rankingSystemId], references: [id], onDelete: Cascade)
  items         RankingSnapshotItem[]

  @@index([rankingSystemId])
  @@index([asOf])
}

/// A competitor's placement within a ranking snapshot.
model RankingSnapshotItem {
  id           String @id @default(cuid())
  snapshotId   String
  competitorId String
  rank         Int
  value        Float?
  movement     Int? // change vs previous snapshot
  detail       Json?

  snapshot   RankingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  competitor Competitor      @relation(fields: [competitorId], references: [id])

  @@unique([snapshotId, competitorId])
  @@index([snapshotId, rank])
  @@index([competitorId])
}

/// A Hall of Fame entry — a curated induction or an all-time leaderboard row
/// (category + rank + value), inducting a player.
model HallOfFameEntry {
  id           String     @id @default(cuid())
  playerId     String
  category     String? // null = general induction; else leaderboard category
  rank         Int?
  value        String?
  citation     String?
  inductedYear Int?
  provenance   Provenance @default(NATIVE)
  createdAt    DateTime   @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([category])
}

// ============================================================================
// PER-PLAYER AGGREGATE STATS (derived / recomputed)
// ============================================================================

/// Per-competition (season) stat line for a player. Derived / recomputed.
model PlayerSeasonStat {
  id            String     @id @default(cuid())
  playerId      String
  competitionId String
  divisionCode  String?
  groupPlayed   Int        @default(0)
  groupWins     Int        @default(0)
  groupLosses   Int        @default(0)
  groupPoints   Float?
  groupWinPct   Float?
  madePlayoffs  Boolean    @default(false)
  playoffSeed   Int?
  result        String? // e.g. "champion", "runner-up", "SF"
  provenance    Provenance @default(NATIVE)

  player      Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([playerId, competitionId, divisionCode])
  @@index([playerId])
  @@index([competitionId])
}

/// Whole-career aggregate for a player (one row per player). Derived / recomputed.
model PlayerCareerStat {
  id                 String     @id @default(cuid())
  playerId           String     @unique
  seasonsPlayed      Int        @default(0)
  totalMatches       Int        @default(0)
  totalWins          Int        @default(0)
  totalLosses        Int        @default(0)
  totalWinPct        Float?
  championships      Int        @default(0)
  runnerUps          Int        @default(0)
  finalsAppearances  Int        @default(0)
  semifinals         Int        @default(0)
  playoffAppearances Int        @default(0)
  longestTitleStreak Int        @default(0)
  longestPlayoffRun  Int        @default(0)
  provenance         Provenance @default(NATIVE)
  updatedAt          DateTime   @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// ============================================================================
// IDENTITY CORRECTIONS (traceable)
// ============================================================================

/// A traceable merge of two canonical players into one (identity de-dup).
model PlayerMerge {
  id                String       @id @default(cuid())
  canonicalPlayerId String
  mergedPlayerId    String
  note              String?
  status            ReviewStatus @default(APPROVED)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime     @default(now())

  canonicalPlayer Player @relation("MergeCanonical", fields: [canonicalPlayerId], references: [id])
  mergedPlayer    Player @relation("MergeMerged", fields: [mergedPlayerId], references: [id])

  @@unique([canonicalPlayerId, mergedPlayerId])
  @@index([canonicalPlayerId])
  @@index([mergedPlayerId])
}

/// A traceable split — a shared identifier was actually two people; a new
/// canonical player is carved out (optionally scoped to a competition/division).
model PlayerSplit {
  id               String       @id @default(cuid())
  sourcePlayerId   String
  newPlayerId      String
  competitionId    String?
  divisionCode     String?
  newPrimaryName   String?
  note             String?
  status           ReviewStatus @default(APPROVED)
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())

  sourcePlayer Player @relation("SplitSource", fields: [sourcePlayerId], references: [id])
  newPlayer    Player @relation("SplitNew", fields: [newPlayerId], references: [id])

  @@index([sourcePlayerId])
  @@index([newPlayerId])
}

// ============================================================================
// PROVENANCE, CORRECTIONS & DISPUTES (cross-cutting, polymorphic)
// ============================================================================

/// A citation for any record — a source file:row, a Wayback URL, or a manual
/// review note. Polymorphic (targetType, targetId). Satisfies "historical
/// source references must remain traceable".
model SourceReference {
  id            String           @id @default(cuid())
  targetType    RecordType
  targetId      String
  kind          SourceKind
  locator       String // "playoffs.csv:88", a URL, etc.
  // Optional structured claim: which field this source speaks to and what value
  // it asserts. Two sources asserting different values for the same (target,field)
  // = a detectable conflict, resolved via a HistoricalCorrection.
  field         String?
  assertedValue String?
  note          String?
  confidence    RecordConfidence @default(UNKNOWN)
  createdAt     DateTime         @default(now())

  @@index([targetType, targetId])
  @@index([targetType, targetId, field])
  @@index([kind])
}

/// A traceable change to a historical record: what was changed, from/to, why,
/// by whom, and its review state. Polymorphic target. Payload versioning covers
/// edits to Payload content; this covers the Prisma-owned competition domain.
model HistoricalCorrection {
  id                String           @id @default(cuid())
  targetType        RecordType
  targetId          String
  field             String?
  beforeValue       Json?
  afterValue        Json?
  reason            String
  status            CorrectionStatus @default(PROPOSED)
  proposedByUserId  String?
  reviewedByUserId  String?
  appliedAt         DateTime?
  sourceReferenceId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([targetType, targetId])
  @@index([status])
}

/// A user-submitted dispute about a record (the public issue-reporting system).
model IssueReport {
  id                  String      @id @default(cuid())
  targetType          RecordType
  targetId            String
  description         String
  suggestedCorrection String?
  reportedByUserId    String? // null for anonymous submissions
  reporterContact     String?
  status              IssueStatus @default(OPEN)
  resolution          String?
  resolvedByUserId    String?
  resolvedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([targetType, targetId])
  @@index([status])
}

// ============================================================================
// LIVE TOURNAMENT OPERATIONS  (8BR standalone tournaments, operated through the website)
// ----------------------------------------------------------------------------
// The active competition domain. Every competition is a standalone Tournament
// (bracket-only, or group-stage → playoffs). These tables are staff-operated in
// real time (registration -> optional groups -> matches -> standings -> playoffs)
// and are the source the PUBLIC site consumes once published. Tables are prefixed
// `comp_` so they never collide with the dormant historical archive above. Users
// live in Payload; we store the Payload user id + a username snapshot (app-level
// reference only -- NO cross-ORM foreign key).
// ============================================================================

enum TournamentRunState {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum RegistrationState {
  NOT_OPEN
  OPEN
  CLOSED
}

enum StageState {
  PENDING
  PUBLISHED
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Lifecycle of a single competition match (group or playoff).
enum LiveMatchStatus {
  SCHEDULED
  COMPLETED
  FORFEIT
  NO_SHOW
  DISPUTED
}

enum VerificationState {
  UNVERIFIED
  VERIFIED
}

/// Explicit Tournament lifecycle state (source of truth — behavior is NEVER inferred from
/// whether a bracket exists). Valid transitions are enforced by the tournament-lifecycle
/// service. Bracket-only:  DRAFT → REGISTRATION_OPEN → REGISTRATION_CLOSED → BRACKET_GENERATED
///   → IN_PROGRESS → COMPLETED. Groups→playoffs inserts GROUPS_IN_PROGRESS after
///   REGISTRATION_CLOSED (groups play out, then top-N qualifiers seed the generated bracket).
///   (any active state) → CANCELLED. Skips/backwards moves require an audited recovery action.
enum TournamentLifecycleState {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  GROUPS_IN_PROGRESS
  BRACKET_GENERATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Participant unit for a competition.
enum ParticipantFormat {
  INDIVIDUAL
  TEAM
}

/// Overall competition structure (drives which workspace sections appear).
enum TournamentFormat {
  SINGLE_ELIM
  DOUBLE_ELIM
  GROUPS_PLAYOFFS
  ROUND_ROBIN
  TEAM_KNOCKOUT
  SWISS
}

/// How a team-format tournament's rosters are formed.
enum TeamFormation {
  PICK // a captain self-registers and picks their roster from registered accounts
  RANDOM // players register solo; teams are shuffled at registration close
}

/// Who may register for a tournament.
enum AccessMode {
  OPEN // any registered account may join
  PASSWORD // a join password is required to register
}

/// Which sub-bracket a tournament match belongs to (single- or double-elimination).
enum TournamentBracketKind {
  MAIN
  WINNERS
  LOSERS
  GRAND_FINAL
}

/// A standalone 8BR tournament. `slug` is the public identifier; `number` is the
/// human-facing tournament number. A tournament is EITHER bracket-only
/// (tournamentFormat = SINGLE_ELIM / DOUBLE_ELIM / TEAM_KNOCKOUT) OR group-stage →
/// playoffs (GROUPS_PLAYOFFS): players play round-robin groups, then the top
/// `qualifiersPerGroup` from each of `groupCount` groups advance into a generated
/// single- or double-elimination playoff bracket (`playoffDoubleElim`).
model Tournament {
  id                   Int                       @id @default(autoincrement())
  slug                 String                    @unique
  name                 String
  /// Competition Year — see Season.competitionYear. Required; defaults to the current calendar
  /// year at creation. Backfilled from scheduledStartAt (else createdAt) for pre-existing rows.
  competitionYear      Int
  status               TournamentRunState        @default(UPCOMING)
  registrationStatus   RegistrationState         @default(NOT_OPEN)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  groupsStatus         StageState                @default(PENDING)
  playoffsStatus       StageState                @default(PENDING)
  raceLength           Int                       @default(5)
  // Group-stage config (GROUPS_PLAYOFFS only). `groupCount` groups, top
  // `qualifiersPerGroup` advance; `playoffSeeding` = how qualifiers seed the bracket
  // ("standing" | "random" | "manual"); `playoffDoubleElim` picks the playoff bracket type.
  groupCount           Int?
  qualifiersPerGroup   Int                       @default(2)
  playoffSeeding       String?                   @default("standing")
  playoffDoubleElim    Boolean                   @default(false)
  /// Free-text note shown under the playoff bracket. Same purpose as Season.playoffDisclaimer:
  /// a reconstructed tournament can say plainly which parts are archived and which were filled in.
  playoffDisclaimer    String?
  formatSummary        String                    @default("Single-elimination bracket")
  eligibilitySummary   String                    @default("Open to all registered 8 Ball Registry account holders.")
  archivedAt           DateTime? // set when the tournament is archived (read-only history)
  /// See the matching fields on Season — one rule, two models.
  publiclyVisible      Boolean                   @default(true)
  reconstruction       Boolean                   @default(false)
  reopenedAt           DateTime?
  dataCompleteness     String                    @default("full")
  /// The Competition this Tournament belongs to — the same canonical table Seasons use.
  ///
  /// Nullable because Tournaments predate the relationship: rows created before it existed have no
  /// answer, and inventing one would be a guess recorded as fact. New Tournaments require it at the
  /// point of creation, which is where the operator actually knows.
  competitionSeriesId  Int?
  competitionSeries    CompetitionSeries?        @relation(fields: [competitionSeriesId], references: [id], onDelete: Restrict)
  code                 String?                   @unique // permanent immutable id, e.g. "T001"
  number               Int?                      @unique // public tournament number
  gameType             String? // e.g. "8-Ball"
  lounge               String                    @default("Social") // Social | Beginner's Lounge | Intermediate Lounge | Advanced Lounge
  participantFormat    ParticipantFormat         @default(INDIVIDUAL)
  teamSize             Int? // members per team when participantFormat = TEAM (2 for 2v2, 5 for 5v5)
  teamFormation        TeamFormation             @default(PICK) // TEAM only: captains pick rosters, or random draw at close
  tournamentFormat     TournamentFormat?
  // Swiss only: number of rounds. Null for non-Swiss (bracket rounds derive from the field size).
  swissRounds          Int?
  // Bracket/Swiss seeding method: "rating" | "rank" | "random" | "registration".
  seedingMethod        String                    @default("rating")
  // Access control. PASSWORD stores a scrypt hash in joinPasswordHash (NEVER the plaintext, never in a URL).
  accessMode           AccessMode                @default(OPEN)
  joinPasswordHash     String?
  // Scheduled start: null = registration opens immediately on create ("start now").
  scheduledStartAt     DateTime?
  // ---- Per-tournament FLAIR (curated, on-brand, server-validated) ----
  // Short description / announcement — stored as PLAIN TEXT (sanitized; no HTML/scripts).
  description          String?
  // Optional badge key from the approved icon set (see lib/competition/flair.ts). Null = none.
  badge                String?
  // NOTE: per-tournament hero banner + accent color were removed — color is now a personal ACCOUNT
  // theme (payload user fields; see src/lib/theme), not a tournament setting. The old
  // `bannerImageUrl`/`accentPreset` columns are dropped by migration 20260813_remove_tournament_flair_colors.
  // EXPLICIT lifecycle state (source of truth for all tournament behavior + gating).
  lifecycleState       TournamentLifecycleState?
  ladderAppliedAt      DateTime? // set once when COMPLETED applies ladder/ranking results (idempotency guard)
  entrantsCount        Int?
  currentRound         String?
  finalScore           String?
  championName         String?
  championHandle       String?
  runnerUpName         String?
  runnerUpHandle       String?
  thirdPlaceName       String?
  thirdPlaceHandle     String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  registrations  Registration[]
  groups         TournamentGroup[]
  matches        TournamentMatch[]
  playoffMatches PlayoffMatch[]
  standings      Standing[]
  bracketMatches TournamentBracketMatch[]
  teams          TournamentTeam[]
  swissMatches   SwissMatch[]
  freeAgents     TournamentFreeAgent[]
  ratingLedger   RatingLedger[]

  /// Articles that reference this competition.
  articleRelations ArticleRelation[]

  @@index([lifecycleState])
  @@index([competitionYear])
  @@index([lifecycleState, publiclyVisible])
  @@index([reconstruction])
  @@index([competitionSeriesId])
  @@map("comp_tournament")
}

/// RATING LEDGER — the authoritative, per-completed-match Elo record (the source of truth for the
/// Rankings/Ladder). One row per player per rated matchup, written transactionally when a tournament
/// is officially closed (COMPLETED). `(matchKey, playerId)` is unique so re-closing / retrying / a
/// deterministic rebuild can never create duplicates. All ladder values (Current 365-day and
/// All-Time, wins/losses/streaks/highest-achieved, match history) are derived from these rows.
///  - Elo: K=32, everyone starts at 1500. actual = 1 win / 0 loss / 0.5 draw.
///  - Forfeit: counts as an official win/loss (result + streak) but ratingChange = 0 (pre == post).
///  - Byes are never written (no win/loss/streak/rating effect).
///  - Team match: opponentId is null; each roster member gets one row with the team's shared change.
model RatingLedger {
  id               Int         @id @default(autoincrement())
  // A ledger row belongs to EITHER a Tournament or a Season (exactly one is set). Both feed the same
  // all-time Ladder; the Season matchKey namespace ("season-group:" / "season-playoff:") keeps them distinct.
  tournamentId     Int?
  tournament       Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  seasonId         Int?
  season           Season?     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  matchKey         String // stable per-match id: "group:<id>" | "playoff:<id>" | "swiss:<id>" | "season-*:<id>"
  stage            String // 'GROUP' | 'PLAYOFF' | 'SWISS'
  roundLabel       String? // display label, e.g. "Final", "Round 1", "Group A"
  playerId         String // resolved competitive identity (Player.id when linked, else a stable handle key)
  playerName       String // display fallback (identity at time of play)
  opponentId       String? // null for a team match (opponent is a team, not one player)
  opponentName     String
  isTeamMatch      Boolean     @default(false)
  teamName         String? // this player's team name (team matches)
  opponentTeamName String? // opposing team name (team matches)
  result           String // 'WIN' | 'LOSS' | 'DRAW'
  isForfeit        Boolean     @default(false) // official result but Elo-neutral (no competitive game played)
  actual           Float // 1 / 0 / 0.5
  preRating        Int
  expected         Float
  ratingChange     Int
  postRating       Int
  sequence         Int // global deterministic order across the whole all-time timeline
  completedAt      DateTime
  createdAt        DateTime    @default(now())

  @@unique([matchKey, playerId])
  @@index([playerId, sequence])
  @@index([tournamentId])
  @@index([seasonId])
  @@index([completedAt])
  @@map("rating_ledger")
}

/// One Swiss-system match on a given round. Swiss is round-based (not a bracket): each round
/// every active entrant is paired, standings are computed from results, and the next round pairs
/// on standings while avoiding repeat opponents. A `bye` (odd field) is a full point with no
/// opponent (awayRegistrationId null). Standings/tiebreaks are computed from these rows in code.
model SwissMatch {
  id                   Int        @id @default(autoincrement())
  tournamentId         Int
  tournament           Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round                Int
  boardOrder           Int
  homeRegistrationId   Int?
  awayRegistrationId   Int? // null = bye
  homeName             String?
  awayName             String?
  homeGames            Int?
  awayGames            Int?
  winnerRegistrationId Int?
  isBye                Boolean    @default(false)
  reportedAt           DateTime?
  createdAt            DateTime   @default(now())

  @@index([tournamentId, round, boardOrder])
  @@map("comp_swiss_match")
}

/// An administrator's saved default FLAIR, applied as the starting point when they create a new
/// tournament ("save as my default" / "restore 8BR default"). Keyed by the Payload user id.
/// All values are curated/validated the same way as per-tournament flair.
model TournamentFlairDefault {
  userId      Int      @id // Payload user id
  description String?
  badge       String?
  updatedAt   DateTime @updatedAt

  @@map("tournament_flair_default")
}

/// A tournament bracket match (single- or double-elimination), the materialized public
/// bracket produced from the live PlayoffMatch rows + champion/runner-up. Slot presence
/// flags distinguish an empty `{}` slot from an absent slot.
model TournamentBracketMatch {
  id           Int                   @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracketKind  TournamentBracketKind @default(MAIN)
  roundName    String
  roundOrder   Int
  matchOrder   Int
  aPresent     Boolean               @default(true)
  aName        String?
  aHandle      String?
  aSeed        Int?
  aScore       Int?
  bPresent     Boolean               @default(true)
  bName        String?
  bHandle      String?
  bSeed        Int?
  bScore       Int?
  winner       String? // "a" | "b"
  note         String?

  @@index([tournamentId, bracketKind, roundOrder, matchOrder])
  @@map("comp_tournament_bracket_match")
}

/// A team entrant in a team-format tournament (2v2, etc.). The team's bracket entrant is a
/// Registration (username = team name), so the entire single-elimination engine
/// (planBracket, PlayoffMatch, advancement, scoring, undo) works unchanged; this row and
/// its members carry the roster shown beneath the team name in the bracket.
model TournamentTeam {
  id             Int                    @id @default(autoincrement())
  tournamentId   Int
  tournament     Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registrationId Int                    @unique // the bracket entrant this team maps to
  registration   Registration           @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  name           String
  // Optional per-team JOIN CODE (scrypt hash only; never the plaintext). Separate field + concept
  // from the tournament ACCESS password (Tournament.joinPasswordHash). Null = open team.
  joinCodeHash   String?
  seed           Int?
  placement      Int?
  withdrawn      Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  members        TournamentTeamMember[]

  @@index([tournamentId])
  @@map("comp_tournament_team")
}

model TournamentTeamMember {
  id            Int            @id @default(autoincrement())
  teamId        Int
  team          TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        Int? // Payload account id — set for self-joined members (one account = one team per tournament)
  playerId      String? // canonical Player.id when the member is linked to a profile
  name          String
  handle        String?
  memberOrder   Int            @default(0)
  captain       Boolean        @default(false)
  // Player's Ladder rating CAPTURED when registration closed — frozen for the tournament so the
  // team-details popover shows stable ratings that don't drift as the ladder updates. Null = unrated.
  ratingAtClose Int?
  createdAt     DateTime       @default(now())

  @@index([teamId])
  @@index([playerId])
  @@index([userId])
  @@map("comp_tournament_team_member")
}

enum AccountClaimStatus {
  UNCLAIMED
  CLAIMED
}

/// A Free Agent's placement state in a player-selected team tournament.
enum FreeAgentStatus {
  WAITING // registered as a free agent, awaiting placement
  PLACED // allocated onto a team at registration close (kept for history)
  NOT_PLACED // could not be placed (too few remaining players); retained, never deleted
}

/// A signed-in account that registered as a FREE AGENT in a player-selected team tournament — a
/// competitor with no team yet, to be allocated at registration close. Exactly one of {team member,
/// free agent} may exist per account per tournament (enforced in the service). Rows are retained
/// after close (status PLACED / NOT_PLACED) for history + audit; never hard-deleted on placement.
model TournamentFreeAgent {
  id           Int             @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       Int // Payload account id
  playerId     String? // canonical Player.id
  name         String
  handle       String? // CueVerse ID
  status       FreeAgentStatus @default(WAITING)
  placedTeamId Int? // the team this agent was allocated to (when PLACED)
  createdAt    DateTime        @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
  @@map("comp_tournament_free_agent")
}

/// Provisioning sidecar for pre-created player accounts. A bulk-generated account is a
/// Payload user (username = CueVerse ID, placeholder email + random password) linked to a
/// Player profile; THIS row holds the claim state so Payload's auth schema is untouched.
/// The single-use claim code is stored only as a hash; plaintext is shown once at
/// generation/reset. Claiming sets the real password/email and marks CLAIMED.
model AccountClaim {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique // Payload user id (users collection)
  playerId           String // linked canonical Player.id
  status             AccountClaimStatus @default(UNCLAIMED)
  claimCodeHash      String? // sha256 of the one-time code; null once claimed
  claimCodeExpiresAt DateTime?
  disabledAt         DateTime? // set when an Owner/Admin disables the account
  createdAt          DateTime           @default(now())
  claimedAt          DateTime?

  @@index([playerId])
  @@map("account_claim")
}

/// A player entry into a tournament — a TOURNAMENT ENTRANT, independent of any website
/// account. An entrant is normally backed by a canonical Player profile (`playerId`);
/// a Payload account (`userId`) is OPTIONAL and, when present, links the entrant to a
/// login. Admins add entrants directly (manual / bulk import); if the player later
/// creates an account, staff link it to the profile and the account adopts the entry.
model Registration {
  id                Int                @id @default(autoincrement())
  tournamentId      Int
  tournament        Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // OPTIONAL Payload account link. Null for account-less entrants (admin-added).
  userId            Int?
  username          String
  status            RegistrationStatus @default(PENDING)
  seed              Int?
  note              String?
  // How the entrant was added — public self-registration vs. admin add / bulk import.
  addedByAdmin      Boolean            @default(false)
  // Identity submitted at registration by an UNLINKED account. Shown publicly until
  // the account is linked to a canonical Player profile, after which `playerId`
  // resolves the entrant to that profile (no duplicate entrant is created).
  displayName       String?
  cueverseId        String?
  discord           String?
  timeZone          String?
  playerId          String? // canonical Player.id — the entrant's competitive identity
  /// Group Stage + Playoffs: an administrator's explicit answer to "does this entrant go through?",
  /// overriding the calculated top-N.
  ///
  /// It lives HERE rather than on Standing because recomputeStandings deletes and rebuilds every
  /// standings row — an override stored there would vanish the next time a result was entered. Null
  /// means "follow the calculation"; true and false are deliberate human decisions that survive it.
  qualifierOverride Boolean?
  createdAt         DateTime           @default(now())
  approvedAt        DateTime?
  withdrawnAt       DateTime?
  approvedByUserId  Int?

  groupPlayers GroupPlayer[]
  team         TournamentTeam? // set when this entrant is a team-format tournament's team

  @@unique([tournamentId, userId])
  @@unique([tournamentId, playerId])
  @@index([tournamentId, status])
  @@index([playerId])
  @@map("comp_registration")
}

/// A group in a group-stage tournament. `published` gates public visibility + edit locking.
model TournamentGroup {
  id             Int        @id @default(autoincrement())
  tournamentId   Int
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  code           String
  name           String
  ordinal        Int
  published      Boolean    @default(false)
  generationSeed String?
  createdAt      DateTime   @default(now())

  players   GroupPlayer[]
  matches   TournamentMatch[]
  standings Standing[]

  @@unique([tournamentId, code])
  @@index([tournamentId])
  @@map("comp_tournament_group")
}

/// A registration placed into a group, with its in-group seed.
model GroupPlayer {
  id             Int             @id @default(autoincrement())
  groupId        Int
  group          TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  registrationId Int
  registration   Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  seed           Int

  @@unique([groupId, registrationId])
  @@index([groupId])
  @@map("comp_group_player")
}

/// A round-robin group match.
model TournamentMatch {
  id                    Int               @id @default(autoincrement())
  tournamentId          Int
  tournament            Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId               Int
  group                 TournamentGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  round                 Int
  homeRegistrationId    Int
  awayRegistrationId    Int
  homeUsername          String
  awayUsername          String
  status                LiveMatchStatus   @default(SCHEDULED)
  homeGames             Int?
  awayGames             Int?
  winnerRegistrationId  Int?
  loserRegistrationId   Int?
  /// FF: the forfeiting (losing) registration. See PlayoffMatch.forfeitRegistrationId.
  forfeitRegistrationId Int?
  verification          VerificationState @default(UNVERIFIED)
  note                  String? // optional admin note attached to the result
  scheduledAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([groupId])
  @@index([tournamentId, verification])
  @@index([tournamentId, status])
  @@map("comp_tournament_match")
}

/// A single-elimination playoff match. Participants may be undetermined until
/// feeding matches resolve. `feedsMatchId`/`feedsSlot` wire the bracket together.
model PlayoffMatch {
  id                    Int               @id @default(autoincrement())
  tournamentId          Int
  tournament            Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round                 Int
  slot                  Int
  label                 String?
  homeRegistrationId    Int?
  awayRegistrationId    Int?
  homeUsername          String?
  awayUsername          String?
  homeSeed              Int?
  awaySeed              Int?
  homeGames             Int?
  awayGames             Int?
  status                LiveMatchStatus   @default(SCHEDULED)
  winnerRegistrationId  Int?
  /// FF: the forfeiting (losing) registration. Same convention as SeasonMatch.forfeitEntrantId —
  /// one rule, two models. Set together with status = FORFEIT and with homeGames/awayGames left
  /// NULL, because no games were played and a fabricated score would be indistinguishable from one.
  forfeitRegistrationId Int?
  verification          VerificationState @default(UNVERIFIED)
  note                  String? // optional admin note attached to the result
  feedsMatchId          Int? // where the WINNER advances
  feedsSlot             Int?
  // Double-elimination: where the LOSER drops to (null = eliminated, e.g. single-elim or LB matches).
  loserFeedsMatchId     Int?
  loserFeedsSlot        Int?
  // Bracket section for double-elim rendering/logic: "WB" (winners) | "LB" (losers) | "GF" (grand final).
  // Null for single-elimination brackets (rendered as one tree).
  section               String?
  published             Boolean           @default(false)
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([tournamentId, round, slot])
  @@map("comp_playoff_match")
}

/// A materialized group standings row. Recomputed (upserted) whenever a verified
/// result changes -- one deterministic compute path, persisted for simple reads.
model Standing {
  id             Int             @id @default(autoincrement())
  tournamentId   Int
  tournament     Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId        Int
  group          TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  registrationId Int
  username       String
  played         Int             @default(0)
  wins           Int             @default(0)
  losses         Int             @default(0)
  /// Group-stage draws. computeStandings has always counted them — a 10-game group set at 5-5 is a
  /// draw worth a point — but there was nowhere to put the number, so the W-L-D on screen was
  /// really W-L with the draws silently folded into neither.
  draws          Int             @default(0)
  gamesWon       Int             @default(0)
  gamesLost      Int             @default(0)
  gameDiff       Int             @default(0)
  points         Int             @default(0)
  rank           Int             @default(0)
  qualified      Boolean         @default(false)
  updatedAt      DateTime        @updatedAt

  @@unique([groupId, registrationId])
  @@index([tournamentId])
  @@map("comp_standing")
}

/// Versioned canonical Tournament snapshot (the DB is the source of truth). Singleton row
/// (id = 1) holding the current tournament payload + a monotonic revision, regenerated
/// TRANSACTIONALLY after every successful tournament mutation so every consumer (public
/// tournament pages, rankings, profiles, homepage, stat services) resolves the same
/// revision. A failed mutation rolls back and leaves the prior revision intact.
model TournamentSnapshot {
  id        Int      @id @default(1)
  revision  Int      @default(0)
  payload   Json
  updatedAt DateTime @updatedAt

  @@map("comp_tournament_snapshot")
}

/// Append-only audit trail for every staff action.
model AuditLog {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  actorUserId   Int
  actorUsername String
  action        String
  entity        String
  entityId      String?
  oldValue      Json?
  newValue      Json?
  reason        String?

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("comp_audit_log")
}

// ============================================================================
// MEMBER MODERATION, PENALTIES & STAFF DESIGNATION
// ----------------------------------------------------------------------------
// Account-level moderation for the LIVE platform. All keyed by the Payload user id
// (app-level reference only — NO cross-ORM foreign key, same pattern as AccountClaim).
// Additive and self-contained: these tables never alter the historical archive or the
// competition tables, and moderation NEVER deletes Player/rankings/match/championship
// history — it withdraws active participation and records an immutable trail.
// ============================================================================

/// Live account status. ACTIVE is the normal state; the others are set by moderation.
/// DELETED is a soft delete (the Payload user may be disabled/anonymised) — the canonical
/// Player and all history are preserved and merely unlinked.
enum MemberStatus {
  ACTIVE
  TIMED_OUT
  BANNED
  DELETED
}

enum PenaltyType {
  TIMEOUT
  BAN
}

/// Moderation status sidecar — exactly one row per Payload user (created lazily the first
/// time an account is moderated). The single authoritative source for whether an account
/// may log in / register. `timeoutUntil` drives automatic timeout expiry.
model MemberModeration {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique // Payload user id
  status       MemberStatus @default(ACTIVE)
  timeoutUntil DateTime? // set for TIMED_OUT; expiry is evaluated live (status is derived when past)
  bannedAt     DateTime?
  deletedAt    DateTime? // soft-delete timestamp
  anonymizedAt DateTime? // set when the account's private data was anonymised
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@map("member_moderation")
}

/// A moderation penalty (timeout or ban). Immutable history: a removal is recorded IN
/// PLACE (removedBy* / removedReason / removedAt), never by deleting the row.
model Penalty {
  id                Int         @id @default(autoincrement())
  userId            Int // Payload user id the penalty applies to
  playerId          String? // canonical Player.id when the account is linked
  type              PenaltyType
  reason            String
  startAt           DateTime    @default(now())
  endAt             DateTime? // timeout expiry; null = indefinite (ban)
  appliedByUserId   Int
  appliedByUsername String
  removedByUserId   Int?
  removedByUsername String?
  removedReason     String?
  removedAt         DateTime?
  // Ban only: a hashed/normalised IP identifier — a SECONDARY safeguard, never the sole
  // basis for enforcement. Null when no trustworthy IP was available.
  ipHash            String?
  createdAt         DateTime    @default(now())

  @@index([userId])
  @@index([type])
  @@index([userId, removedAt])
  @@map("member_penalty")
}

/// A moderation warning — history only, NEVER a penalty (no enforcement effect). Staff-visible.
model Warning {
  id            Int      @id @default(autoincrement())
  userId        Int // Payload user id
  playerId      String? // canonical Player.id when linked
  reason        String
  internalNotes String? // staff-only, never public
  staffUserId   Int
  staffUsername String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("member_warning")
}

/// Staff designation sidecar. Presently carries only the single Head Administrator flag.
/// Keyed by the Payload user id. The invariant "exactly one headAdmin whenever any
/// Administrator exists" is enforced in the staff-roles service, not by the schema.
model StaffDesignation {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique // Payload user id
  headAdmin Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([headAdmin])
  @@map("staff_designation")
}

/// Admin-initiated password reset state (Prisma-owned sidecar; Payload owns the credential itself).
/// When an Admin/Head-Admin resets a player's password, a temporary numeric code is set as the
/// Payload password and this row records the forced-change + short expiry. The temp code is NEVER
/// stored here in plaintext — only its bcrypt hash, for a constant-time login check and attempt limit.
/// The row is deleted once the player sets a permanent password (or lets it expire).
model PasswordResetState {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique // Payload user id
  forceChange  Boolean  @default(true) // player must set a permanent password before normal use
  tempCodeHash String // bcrypt hash of the one-time numeric code (never the plaintext)
  expiresAt    DateTime // temp code is invalid after this (default: +15 min)
  attempts     Int      @default(0) // failed temp-code entries (brute-force guard)
  issuedByUser Int // actor (Payload user id) who performed the reset
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
  @@map("password_reset_state")
}

// ============================================================================
// SEASON DOMAIN — a first-class competition type, NOT a Tournament.
// Separate storage with its own lifecycle, routes, UI and authorization. Reuses
// the PURE planners (groups/schedule/standings/scoring/bracket) but never the
// Tournament tables. Completed Seasons feed the same Ladder via a `season:`
// rating-ledger namespace (added in a later migration). Reuses shared enums
// AccessMode and VerificationState.
// ============================================================================

enum SeasonLifecycleState {
  REGISTRATION_SCHEDULED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  GROUP_SETUP
  GROUP_STAGE_LIVE
  GROUPS_CLOSED
  PLAYOFF_SETUP
  PLAYOFFS_LIVE
  COMPLETED
}

enum SeasonEntrantStatus {
  PENDING
  APPROVED
  WITHDRAWN
  KICKED_OUT
}

/// Match resolution for Season group + playoff matches.
///  COMPLETED   = played with a numeric result (or a draw in groups)
///  FORFEIT     = FF: opponent awarded the match; Elo-neutral, no games counted
///  NO_CONTEST  = close-groups override: unplayed; excluded from everything
///  VOID        = KO-voided (a kicked entrant matches); excluded from everything
enum SeasonMatchStatus {
  SCHEDULED
  COMPLETED
  FORFEIT
  NO_CONTEST
  VOID
}

enum SeasonQualification {
  NOT_SELECTED
  AUTOMATIC
  WILDCARD
  DISQUALIFIED
  KICKED_OUT
}

/// A Competition (internally CompetitionSeries) — the recurring competition a Season belongs to,
/// e.g. 8BRCAM. Named CompetitionSeries in code so it is never confused with an individual
/// Tournament record; every user-facing label says "Competition".
///
/// The icon reuses the existing Payload media system: `iconMediaId` stores a Payload media id as a
/// plain string (no cross-ORM FK, matching Season.bannerMediaId). No image bytes live in Postgres.
/// When it is null the UI renders an initials fallback badge from `shortName`.
model CompetitionSeries {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  /// Short name / acronym, also the source for the initials fallback badge.
  shortName   String
  iconMediaId String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seasons     Season[]
  tournaments Tournament[]

  /// Articles that reference this Competition.
  articleRelations ArticleRelation[]

  @@index([active])
  @@map("competition_series")
}

model Season {
  id                  Int                  @id @default(autoincrement())
  /// Public Season number, unique only WITHIN a Competition and year — see the composite key at the
  /// bottom of the model. "8BR Season 1 - 2005", "8BR Retro Season 1 - 2026" and "8BR Season 1 -
  /// 2026" are all valid at once. Never a global identifier: routes and relationships use `id`.
  /// A CHECK constraint keeps it a positive whole number.
  number              Int
  /// Competition Year — the four-digit year the competition belongs to. Required; defaults to the
  /// current calendar year at creation. Historical and future years are allowed (1900-2100, range
  /// enforced by a CHECK constraint). Deliberately NOT unique: many competitions share a year.
  /// Primary sort key for every chronological listing.
  competitionYear     Int
  /// Owning Competition. Required: every Season belongs to exactly one Competition. Restrict on
  /// delete so removing a Competition can never silently orphan or delete its Seasons.
  competitionSeriesId Int
  competitionSeries   CompetitionSeries    @relation(fields: [competitionSeriesId], references: [id], onDelete: Restrict)
  slug                String               @unique
  subtitle            String? // optional custom subtitle; official title is "8BR Season N - YEAR"
  lifecycleState      SeasonLifecycleState @default(REGISTRATION_SCHEDULED)

  lounge              String     @default("Social")
  accessMode          AccessMode @default(OPEN)
  joinPasswordHash    String?
  registrationOpensAt DateTime?
  scheduledStartAt    DateTime?
  description         String?
  bannerMediaId       String? // Payload media id (no cross-ORM FK)

  // Editable match formats -- intended labels only, never enforced as winning scores.
  groupStageGames Int @default(10)
  earlyRaceTo     Int @default(7)
  semifinalRaceTo Int @default(9)
  finalRaceTo     Int @default(9)

  /// Division this Season belongs to, when the competition ran divided ones: "A", "B", ...
  ///
  /// Deliberately a nullable free-text code on the Season rather than a table or an enum. The
  /// archive import that will populate it has not happened yet, and the decision about whether a
  /// divided year is one Season record or two has not been made — a relationship or a fixed enum
  /// would force that decision now. A nullable code costs nothing to widen later and nothing to
  /// drop if divisions turn out to belong somewhere else.
  ///
  /// NEVER inferred. Every existing Season predates the distinction and stays null, which the
  /// Rankings filter reports as "Unassigned" rather than guessing a division from a name or a year.
  division           String?
  /// ── Lifecycle presentation state (Live / Archives / Creator) ──────────────────────────────────
  /// Publicly visible. Separate from lifecycle on purpose: a Season can be running and still be
  /// private, and a published Season can be finished. Live requires BOTH.
  /// Defaults true so every existing Season keeps behaving exactly as it does today.
  publiclyVisible    Boolean   @default(true)
  /// Built in Creator by hand from an archive rather than played on the site. Never appears under
  /// Live while it is being entered; moves to Archives only once completed and finalised.
  reconstruction     Boolean   @default(false)
  /// Links a reconstruction shell to its entry in the 8BRCAM archive manifest.
  ///
  /// Nullable and additive: every existing Season has none, which is correct — they were not built
  /// from the archive. It holds a manifest key, never archive DATA, so the source of truth for what
  /// the archive said stays the manifest file and this is only the pointer to it.
  archiveTemplateKey String?   @unique
  /// Set while an authorised administrator has reopened a completed Season for correction. While
  /// this is set the Season leaves Archives and stops contributing to the rankings.
  reopenedAt         DateTime?
  cancelledAt        DateTime?
  deletedAt          DateTime?
  /// 'full' | 'partial'. A claim about the SOURCE archive, not about the entry: 'partial' means
  /// some matches, scores or dates were never preserved and have been left missing rather than
  /// invented. Shown on the archive card.
  dataCompleteness   String    @default("full")
  playoffDoubleElim  Boolean   @default(false) // decided at playoff setup, not creation
  /// Free-text note shown under the playoff bracket, to anyone who can see it. Optional and usually
  /// empty; it exists so a reconstructed season can say plainly where its bracket came from — e.g.
  /// that the pairings are archived but the scores are not, and have been approximated.
  playoffDisclaimer  String?

  ratingSnapshotAt DateTime? // set when registration closes (locks seeding ratings)
  ladderAppliedAt  DateTime? // idempotency guard for close -> Ladder

  entrantsCount    Int       @default(0)
  championName     String?
  championHandle   String?
  championPlayerId String?
  runnerUpName     String?
  runnerUpHandle   String?
  finalScore       String?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entrants       SeasonEntrant[]
  groups         SeasonGroup[]
  matches        SeasonMatch[]
  standings      SeasonStanding[]
  playoffMatches SeasonPlayoffMatch[]
  ratingLedger   RatingLedger[]

  /// Articles that reference this competition.
  articleRelations ArticleRelation[]

  /// The numbering rule, enforced by the database so a race between two creates cannot slip past it.
  /// Season numbering is unique per Competition, year AND division.
  ///
  /// The 8BRCAM archive ran Division A and Division B of one Season under a single number, so the
  /// pair has to be able to coexist. The DATABASE index also folds a NULL division to '' so two
  /// undivided Seasons still cannot share a number — Prisma cannot express that, which is why the
  /// real constraint lives in 20260820_030000_season_number_per_division.
  @@unique([competitionSeriesId, competitionYear, number, division], name: "season_competition_year_number")
  @@index([lifecycleState])
  @@index([competitionYear])
  @@index([competitionSeriesId])
  @@index([division])
  /// Live and Archives both filter on lifecycle first, then on these two flags.
  @@index([lifecycleState, publiclyVisible])
  @@index([reconstruction])
  @@map("season")
}

model SeasonEntrant {
  id             Int                 @id @default(autoincrement())
  seasonId       Int
  userId         Int? // Payload user id (self-registration)
  playerId       String? // canonical Player id
  username       String
  displayName    String?
  cueverseId     String?
  status         SeasonEntrantStatus @default(APPROVED)
  seed           Int?
  addedByAdmin   Boolean             @default(false)
  ratingSnapshot Int? // locked Ladder rating captured at registration close

  // Playoff selection (set on the playoff setup page).
  playoffIncluded     Boolean             @default(false)
  qualification       SeasonQualification @default(NOT_SELECTED)
  qualificationReason String?
  playoffSeed         Int?

  // KO administrative state.
  kickedOut      Boolean   @default(false)
  kickedReason   String?
  kickedAt       DateTime?
  kickedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season       Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  groupPlayers SeasonGroupPlayer[]

  @@unique([seasonId, userId])
  @@unique([seasonId, playerId])
  @@index([seasonId])
  @@map("season_entrant")
}

model SeasonGroup {
  id             Int      @id @default(autoincrement())
  seasonId       Int
  code           String // A, B, C, ...
  name           String?
  ordinal        Int
  published      Boolean  @default(false)
  generationSeed Int?
  createdAt      DateTime @default(now())

  season    Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  players   SeasonGroupPlayer[]
  matches   SeasonMatch[]
  standings SeasonStanding[]

  @@unique([seasonId, code])
  @@index([seasonId])
  @@map("season_group")
}

model SeasonGroupPlayer {
  id        Int  @id @default(autoincrement())
  groupId   Int
  entrantId Int
  seed      Int?

  group   SeasonGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entrant SeasonEntrant @relation(fields: [entrantId], references: [id], onDelete: Cascade)

  @@unique([groupId, entrantId])
  @@index([entrantId])
  @@map("season_group_player")
}

model SeasonMatch {
  id               Int               @id @default(autoincrement())
  seasonId         Int
  groupId          Int
  round            Int
  homeEntrantId    Int
  awayEntrantId    Int
  homeUsername     String
  awayUsername     String
  status           SeasonMatchStatus @default(SCHEDULED)
  homeGames        Int?
  awayGames        Int?
  winnerEntrantId  Int?
  loserEntrantId   Int?
  forfeitEntrantId Int? // FF: the forfeiting (losing) entrant
  note             String?
  version          Int               @default(0) // optimistic concurrency for batch saves
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  season Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  group  SeasonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([seasonId, status])
  @@map("season_match")
}

model SeasonStanding {
  id        Int      @id @default(autoincrement())
  seasonId  Int
  groupId   Int
  entrantId Int
  username  String
  played    Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  gamesWon  Int      @default(0)
  gamesLost Int      @default(0)
  points    Int      @default(0)
  rank      Int      @default(0)
  qualified Boolean  @default(false)
  updatedAt DateTime @updatedAt

  season Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  group  SeasonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, entrantId])
  @@index([seasonId])
  @@map("season_standing")
}

model SeasonPlayoffMatch {
  id                Int               @id @default(autoincrement())
  seasonId          Int
  round             Int
  slot              Int
  label             String?
  homeEntrantId     Int?
  awayEntrantId     Int?
  homeUsername      String?
  awayUsername      String?
  homeSeed          Int?
  awaySeed          Int?
  homeGames         Int?
  awayGames         Int?
  status            SeasonMatchStatus @default(SCHEDULED)
  winnerEntrantId   Int?
  verification      VerificationState @default(UNVERIFIED)
  note              String?
  feedsMatchId      Int?
  feedsSlot         Int?
  loserFeedsMatchId Int?
  loserFeedsSlot    Int?
  section           String? // WB / LB / GF; null = single-elim
  published         Boolean           @default(false)
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, round, slot])
  @@map("season_playoff_match")
}

// ============================================================================
// The Break — editorial publishing
//
// One canonical, Prisma-backed article system. It lives here rather than in
// Payload because authorship, permissions, comments, account merges and
// account-deletion safeguards are all tied to the main application's accounts,
// and splitting that across two stores would mean duplicated authentication and
// unresolvable ownership. Images stay in the Payload Media system and are
// referenced by media id, exactly as the rest of the site does.
//
// Visibility is a pure function of (state, publishAt) — see ArticleState — so
// scheduled publishing needs no background worker to become visible.
// ============================================================================

/// Editorial lifecycle. PUBLISHED here means "approved to appear"; whether it
/// is actually visible also depends on publishAt, which is what makes
/// scheduling work without a scheduler.
enum ArticleState {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
  SOFT_DELETED
}

model ArticleCategory {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  /// Only administrators may file an article under a category marked official.
  adminOnly   Boolean  @default(false)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  @@index([active, sortOrder])
  @@map("article_category")
}

model ArticleTag {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  articles ArticleTagLink[]

  @@map("article_tag")
}

model ArticleTagLink {
  articleId Int
  tagId     Int
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tag_link")
}

model Article {
  id Int @id @default(autoincrement())

  /// Canonical author identity. Nullable so an archived author leaves the
  /// article standing; the snapshot below is what renders when it is null.
  authorPlayerId       String?
  authorPlayer         Player? @relation("ArticleAuthor", fields: [authorPlayerId], references: [id], onDelete: SetNull)
  /// Frozen at publication so an archived or renamed account cannot blank an
  /// article's byline.
  authorNameSnapshot   String
  authorHandleSnapshot String?

  title   String
  /// Lower-cased in `slugKey` for case-insensitive uniqueness; `slug` keeps the
  /// author's casing for display.
  slug    String
  slugKey String  @unique
  excerpt String?
  /// Structured rich text, sanitised server-side. Never raw HTML.
  body    Json

  coverMediaId String?
  coverAlt     String?

  categoryId Int?
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  state     ArticleState @default(DRAFT)
  /// An article is public only when state = PUBLISHED AND publishAt <= now().
  publishAt DateTime?

  /// Administrator-only. Marks content as speaking for 8 Ball Registry.
  official Boolean @default(false)
  featured Boolean @default(false)
  pinned   Boolean @default(false)
  pinOrder Int     @default(0)

  commentsEnabled Boolean @default(true)
  commentsLocked  Boolean @default(false)

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  revision     Int @default(1)
  viewCount    Int @default(0)
  commentCount Int @default(0)

  /// Set while a member edits an already-published article: the live revision
  /// keeps serving until an administrator approves the proposal.
  pendingBody        Json?
  pendingTitle       String?
  pendingExcerpt     String?
  pendingSubmittedAt DateTime?

  reviewerPlayerId String?
  reviewerPlayer   Player? @relation("ArticleReviewer", fields: [reviewerPlayerId], references: [id], onDelete: SetNull)
  /// Private to the author and administrators — never rendered publicly.
  reviewFeedback   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  approvedAt  DateTime?
  publishedAt DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?

  tags        ArticleTagLink[]
  revisions   ArticleRevision[]
  slugHistory ArticleSlugHistory[]
  comments    ArticleComment[]
  metrics     ArticleDailyMetric[]
  relations   ArticleRelation[]

  @@index([state, publishAt])
  @@index([authorPlayerId])
  @@index([categoryId])
  @@index([featured, state, publishAt])
  @@index([official, state, publishAt])
  @@index([pinned, pinOrder])
  @@map("article")
}

/// A published-article URL that has changed. Old links redirect instead of 404ing.
model ArticleSlugHistory {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  slugKey   String   @unique
  slug      String
  createdAt DateTime @default(now())

  @@index([articleId])
  @@map("article_slug_history")
}

/// A point-in-time copy, kept so a publishing or moderation action can be
/// reversed. Deliberately NOT a general activity log.
model ArticleRevision {
  id             Int      @id @default(autoincrement())
  articleId      Int
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revision       Int
  title          String
  excerpt        String?
  body           Json
  /// Who saved it, and what it was called at the time.
  editorPlayerId String?
  editorName     String
  note           String?
  createdAt      DateTime @default(now())

  @@unique([articleId, revision])
  @@index([articleId, createdAt])
  @@map("article_revision")
}

/// What an article is about, pointing into the competition domain. One row per
/// link so a query can go in either direction without scanning JSON.
model ArticleRelation {
  id        Int     @id @default(autoincrement())
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  competitionSeriesId Int?
  seasonId            Int?
  tournamentId        Int?
  playerId            String?

  competitionSeries CompetitionSeries? @relation(fields: [competitionSeriesId], references: [id], onDelete: Cascade)
  season            Season?            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tournament        Tournament?        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player            Player?            @relation("ArticleRelatedPlayer", fields: [playerId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([competitionSeriesId])
  @@index([seasonId])
  @@index([tournamentId])
  @@index([playerId])
  @@map("article_relation")
}

model ArticleComment {
  id        Int     @id @default(autoincrement())
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// One level of replies only — a reply may not itself be replied to.
  parentId Int?
  parent   ArticleComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ArticleComment[] @relation("CommentReplies")

  authorPlayerId     String?
  authorPlayer       Player? @relation("CommentAuthor", fields: [authorPlayerId], references: [id], onDelete: SetNull)
  authorNameSnapshot String

  body String

  editedAt         DateTime?
  /// Withdrawn by its author. The row survives so replies keep their place.
  deletedAt        DateTime?
  /// Removed by a moderator, which is a different thing from the author
  /// deleting it and is recorded separately.
  hiddenAt         DateTime?
  hiddenByPlayerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports CommentReport[]

  @@index([articleId, createdAt])
  @@index([parentId])
  @@index([authorPlayerId])
  @@map("article_comment")
}

model CommentReport {
  id        Int            @id @default(autoincrement())
  commentId Int
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reporterPlayerId   String?
  reason             String
  /// Open until a moderator acts on it.
  resolvedAt         DateTime?
  resolvedByPlayerId String?
  resolution         String?
  createdAt          DateTime  @default(now())

  @@unique([commentId, reporterPlayerId])
  @@index([resolvedAt])
  @@map("comment_report")
}

/// The minimum needed to undo a publishing or moderation action. Not an
/// activity log: nothing is written here that is not required to reverse
/// something.
model EditorialModerationRecord {
  id            Int      @id @default(autoincrement())
  action        String
  articleId     Int?
  commentId     Int?
  actorPlayerId String?
  actorName     String
  detail        Json?
  createdAt     DateTime @default(now())

  @@index([articleId])
  @@index([commentId])
  @@index([createdAt])
  @@map("editorial_moderation_record")
}

/// Daily counters. No IP addresses, no per-visitor rows — just a tally per
/// article per day, which is enough to rank "most discussed" without tracking
/// anybody.
model ArticleDailyMetric {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)

  @@unique([articleId, day])
  @@index([day])
  @@map("article_daily_metric")
}

/// Administrator-only standalone pages (About, FAQ and the like). Same editor,
/// revisions and media as an article, but never listed as news.
model EditorialPage {
  id      Int     @id @default(autoincrement())
  slug    String  @unique
  title   String
  body    Json
  excerpt String?

  state     ArticleState @default(DRAFT)
  publishAt DateTime?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  /// Off by default; an administrator opts a page into the navigation.
  showInNav Boolean @default(false)
  navOrder  Int     @default(0)

  commentsEnabled Boolean @default(false)

  revision    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  @@index([state, publishAt])
  @@map("editorial_page")
}

/// Singleton (id = 1) holding the homepage editorial choices. Every field has a
/// working default, so the homepage renders correctly with no configuration.
model EditorialSettings {
  id Int @id @default(1)

  featuredArticleId Int?

  showFeatured    Boolean @default(true)
  showOfficial    Boolean @default(true)
  showPredictions Boolean @default(true)
  showCommunity   Boolean @default(true)
  showDiscussed   Boolean @default(true)

  sectionOrder Json?

  updatedAt DateTime @updatedAt

  @@map("editorial_settings")
}

// ============================================================================
// CueVerse leaderboard mirror
//
// A local copy of the public CueVerse top-5, refreshed on a schedule rather than
// on demand. The homepage reads only from here, so a CueVerse outage, a slow
// response or a markup change can never delay or break a page render.
//
// Only public leaderboard data is stored. Nothing here is joined to an 8 Ball
// Registry player: the two identity spaces are deliberately separate, and
// guessing that a CueVerse name is a particular member would be a claim the data
// does not support.
// ============================================================================

/// One successful fetch of the CueVerse leaderboard. Snapshots accumulate so a
/// bad import can be rolled back to the previous good one, and so the "updated"
/// line on the homepage is a fact rather than an assumption.
model CueVerseSnapshot {
  id Int @id @default(autoincrement())

  /// Which external service this came from. Present so a second provider could
  /// be added later without the reader having to guess what a row means.
  provider String @default("cueverse")

  /// When this application successfully fetched it.
  fetchedAt       DateTime  @default(now())
  /// When the SOURCE says its data was current, when it tells us. Usually null.
  sourceUpdatedAt DateTime?

  /// Digest of the normalised entries. Lets a repeat fetch recognise that
  /// nothing changed without comparing rows one by one.
  checksum String?

  /// The raw response, for diagnosing a shape change. Bounded before storage.
  raw Json?

  /// Live figures the same endpoint reports. Public, and useful context.
  playersOnline Int?
  tablesActive  Int?

  entries CueVerseSnapshotEntry[]

  @@index([provider, fetchedAt])
  @@map("cueverse_snapshot")
}

/// One leaderboard row, stored in the source's own order.
model CueVerseSnapshotEntry {
  id         Int              @id @default(autoincrement())
  snapshotId Int
  snapshot   CueVerseSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// Position as supplied by the source. Never recomputed from the rating.
  rank Int
  /// The display name exactly as supplied, after sanitisation.
  name String

  rating      Int
  /// Secondary public statistics. Null when the source omits them.
  wins        Int?
  losses      Int?
  provisional Boolean @default(false)

  @@unique([snapshotId, rank])
  @@index([snapshotId])
  @@map("cueverse_snapshot_entry")
}

/// One media upload made through the article editor.
///
/// Two jobs. It gives uploads durable rate limiting — a per-process counter resets on restart and
/// this application runs more than one instance, so a limit held in memory is not a limit. And it
/// records who put a file there, which the Payload media collection does not, so an orphan sweep can
/// tell a member's abandoned paste from site imagery an administrator uploaded.
model MediaUpload {
  id Int @id @default(autoincrement())

  /// The Payload media filename, which is how article bodies reference it.
  filename String

  /// Canonical Player who uploaded it. Nullable so removing a profile never deletes the provenance
  /// of a file that is still referenced by a published article.
  uploaderPlayerId String?
  uploader         Player? @relation("MediaUploader", fields: [uploaderPlayerId], references: [id], onDelete: SetNull)

  mimeType String
  bytes    Int
  /// Recorded when the source provides them; used for the dimension ceiling and for layout hints.
  width    Int?
  height   Int?

  createdAt DateTime @default(now())

  @@index([uploaderPlayerId, createdAt])
  @@index([filename])
  @@map("media_upload")
}

/// Site configuration as key/value rows.
///
/// Declared here because the production build reconciles the database with this schema using
/// `prisma db push --accept-data-loss`. A table that exists in the database but NOT in this file is
/// drift, and db push resolves drift by DROPPING it. This table holds the "Create an Account" mode
/// and its registration code, so omitting it would have wiped the launch configuration on the first
/// deploy — silently, because db push reports a dropped table as success.
///
/// The table itself is created by 20260818_140000_site_setting_and_registration_mode; this model
/// exists so the schema and the database agree about it.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("site_setting")
}

/// Failed registration-code attempts, for rate limiting.
///
/// Declared for the same reason as SiteSetting: undeclared tables are dropped by db push. Losing
/// this one would be less damaging — it holds only recent failures — but it would silently reset
/// every rate limit on each deploy.
model RegistrationAttempt {
  id         BigInt   @id @default(autoincrement())
  clientHash String   @map("client_hash")
  createdAt  DateTime @default(now())

  // Named to match the index the migration created, so db push has nothing at all to do.
  @@index([clientHash, createdAt], map: "registration_attempt_client_created_idx")
  @@map("registration_attempt")
}

// ═════════════════════════════════════════════════════════════════════════════════════════════════
// THE BREAK — one sitewide community: posts, threaded comments, voting, moderation.
//
// Everything here is ADDITIVE. The editorial tables (article, article_comment, …) are left in place
// and untouched: the migration reads them, and keeping them means the compatibility period is real
// rather than a claim. Nothing in this section touches Seasons, Cups, players, matches or ratings.
//
// ── Naming ───────────────────────────────────────────────────────────────────────────────────────
// Every model and table is prefixed `Break` / `break_`, so it is never ambiguous which publishing
// system a table belongs to while both exist.
//
// ── Canonical rows and cached counters ───────────────────────────────────────────────────────────
// Votes, saves and reports each have a real row with a unique constraint. The `score`, `upvotes`,
// `commentCount` and similar fields on posts and comments are CACHES, maintained in the same
// transaction as the row that changes them, and rebuildable from the canonical rows at any time by
// the reconciliation service. Where the two disagree, the rows are right.
// ═════════════════════════════════════════════════════════════════════════════════════════════════

enum BreakPostType {
  TEXT
  IMAGE
  GALLERY
  GIF
  VIDEO
  LINK
  POLL
}

enum BreakPostState {
  /// Visible only to its author. Never appears in a feed, a search or an API listing.
  DRAFT
  PUBLISHED
  /// Taken down by a moderator. The row survives, the discussion survives, the body is withheld.
  REMOVED
  /// Withdrawn by its author. If it has comments a shell remains so the thread is not orphaned.
  DELETED
}

enum BreakMediaKind {
  IMAGE
  GIF
  VIDEO
}

enum BreakMediaStatus {
  /// Uploaded, not yet usable — a video still being probed or normalised.
  PENDING
  READY
  /// Processing failed. The post stays a draft; the author can retry or remove the item.
  FAILED
}

enum BreakReportReason {
  SPAM
  HARASSMENT
  PERSONAL_INFO
  CHEATING
  OFF_TOPIC
  INAPPROPRIATE_MEDIA
  IMPERSONATION
  OTHER
}

enum BreakReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum BreakNotificationKind {
  POST_REPLY
  COMMENT_REPLY
  MENTION
  MOD_REMOVED
  MOD_RESTORED
  MOD_LOCKED
  POLL_CLOSED
  OFFICIAL_REPLY
}

/// A filter within The Break — NOT a separate community. Every published post has exactly one.
model BreakCategory {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  name        String
  description String?
  /// Token name or hex for the chip, so staff can recolour without a deploy.
  color       String  @default("gold")
  /// Only staff may file a post here. Announcement uses this.
  adminOnly   Boolean @default(false)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BreakPost[]

  @@index([active, sortOrder])
  @@map("break_category")
}

model BreakPost {
  id    Int            @id @default(autoincrement())
  type  BreakPostType  @default(TEXT)
  state BreakPostState @default(DRAFT)

  /// Canonical Player. Nullable so removing a profile leaves the post standing under its snapshot.
  authorPlayerId       String?
  authorPlayer         Player? @relation("BreakPostAuthor", fields: [authorPlayerId], references: [id], onDelete: SetNull)
  /// Frozen at publication so a rename cannot rewrite history. A merge DOES repoint authorPlayerId
  /// and refresh these, which is the one case where the byline is supposed to change.
  authorNameSnapshot   String
  authorHandleSnapshot String?

  title    String
  /// `slug` keeps the author's casing for display; `slugKey` is lower-cased and unique.
  slug     String
  slugKey  String  @unique
  /// Structured rich text, sanitised server-side. Never raw HTML.
  body     Json?
  /// Flattened plain text, maintained alongside `body` purely so search has something indexable.
  bodyText String?

  categoryId Int?
  category   BreakCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // ── Link posts ────────────────────────────────────────────────────────────────────────────────
  linkUrl            String?
  linkDomain         String?
  linkTitle          String?
  linkDescription    String?
  linkImageUrl       String?
  /// The author may delete a generated preview without deleting the link.
  linkPreviewRemoved Boolean @default(false)

  // ── Flags ─────────────────────────────────────────────────────────────────────────────────────
  spoiler         Boolean @default(false)
  sensitive       Boolean @default(false)
  official        Boolean @default(false)
  pinned          Boolean @default(false)
  pinOrder        Int     @default(0)
  locked          Boolean @default(false)
  commentsEnabled Boolean @default(true)
  /// The author opting out of reply notifications for this post.
  muteReplies     Boolean @default(false)

  // ── Moderation and deletion ───────────────────────────────────────────────────────────────────
  removedAt         DateTime?
  removedByPlayerId String?
  /// Shown publicly in place of the body. Distinct from the private moderator note.
  removalReason     String?
  deletedAt         DateTime?
  editedAt          DateTime?
  publishedAt       DateTime?

  // ── Cached counters. Canonical rows are the source of truth; see the reconciliation service. ──
  score        Int   @default(0)
  upvotes      Int   @default(0)
  downvotes    Int   @default(0)
  commentCount Int   @default(0)
  viewCount    Int   @default(0)
  saveCount    Int   @default(0)
  reportCount  Int   @default(0)
  shareCount   Int   @default(0)
  /// Precomputed Hot ordering key, recomputed on vote and comment. Indexed so the default feed is
  /// an index scan rather than a sort over every post.
  hotRank      Float @default(0)

  /// An internal repost points at the ROOT original, never at another repost — the service resolves
  /// the chain before writing, so a repost of a repost cannot form one.
  repostOfId Int?
  repostOf   BreakPost?  @relation("BreakRepost", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts    BreakPost[] @relation("BreakRepost")

  /// Set when this post was migrated from the editorial system, so the two can be reconciled and the
  /// old URL can be redirected to the new one.
  legacyArticleId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media         BreakPostMedia[]
  poll          BreakPoll?
  comments      BreakComment[]
  votes         BreakPostVote[]
  saves         BreakSavedPost[]
  hides         BreakHiddenPost[]
  reports       BreakReport[]
  slugHistory   BreakPostSlug[]
  views         BreakPostDailyView[]
  notifications BreakNotification[]

  // Feed sorts. Each is a real access path, not decoration:
  @@index([state, pinned, pinOrder]) // pinned band, read first
  @@index([state, hotRank]) // Hot
  @@index([state, publishedAt]) // New, and the Top time windows
  @@index([state, score, publishedAt]) // Top
  @@index([state, publishedAt, score]) // Rising (recent window, then velocity)
  @@index([authorPlayerId, state, publishedAt]) // a member's own posts and drafts
  @@index([categoryId, state, publishedAt]) // category filter
  @@index([state, removedAt, deletedAt]) // public-visibility predicate
  @@map("break_post")
}

/// A URL a post has had before. Retitling must never break a link that is already shared.
model BreakPostSlug {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      BreakPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  slugKey   String    @unique
  slug      String
  createdAt DateTime  @default(now())

  @@index([postId])
  @@map("break_post_slug")
}

model BreakPostMedia {
  id     Int       @id @default(autoincrement())
  postId Int
  post   BreakPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// Position within a gallery. Zero for single-media posts.
  position Int              @default(0)
  kind     BreakMediaKind
  status   BreakMediaStatus @default(READY)

  /// Application-relative path served by the media route, never a raw filesystem path.
  url         String
  /// The storage key the media abstraction owns — local file in development, Blob key in production.
  storageKey  String?
  mimeType    String
  bytes       Int     @default(0)
  width       Int?
  height      Int?
  /// Seconds. Videos only.
  duration    Float?
  posterUrl   String?
  /// Captions/subtitles track, when one was supplied.
  captionsUrl String?

  alt     String?
  caption String?

  /// 'upload' or 'giphy'. A GIPHY item is referenced canonically rather than re-hosted.
  sourceProvider String  @default("upload")
  sourceId       String?

  /// Why processing failed, for the author's retry affordance.
  error String?

  createdAt DateTime @default(now())

  @@index([postId, position])
  @@index([status])
  @@map("break_post_media")
}

model BreakPoll {
  id     Int       @id @default(autoincrement())
  postId Int       @unique
  post   BreakPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  closesAt   DateTime?
  closedAt   DateTime?
  /// Cached; canonical count is the vote rows.
  totalVotes Int       @default(0)

  createdAt DateTime @default(now())

  options BreakPollOption[]
  votes   BreakPollVote[]

  @@map("break_poll")
}

model BreakPollOption {
  id        Int       @id @default(autoincrement())
  pollId    Int
  poll      BreakPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  position  Int       @default(0)
  text      String
  voteCount Int       @default(0)

  votes BreakPollVote[]

  @@index([pollId, position])
  @@map("break_poll_option")
}

/// One vote per account per poll, enforced by the database rather than by the handler.
model BreakPollVote {
  id        Int             @id @default(autoincrement())
  pollId    Int
  poll      BreakPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  Int
  option    BreakPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player          @relation("BreakPollVoter", fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([pollId, playerId])
  @@index([optionId])
  @@map("break_poll_vote")
}

model BreakComment {
  id     Int       @id @default(autoincrement())
  postId Int
  post   BreakPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   BreakComment?  @relation("BreakCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  BreakComment[] @relation("BreakCommentReplies")

  /**
   * A materialised path, so a whole thread is ONE indexed range scan.
   * Walking parent pointers costs a query per level, which is the classic way a comment tree becomes
   * the slowest page on a site. `path` is the dot-joined zero-padded ancestor ids ("0000123.0000456")
   * and sorts into exactly the display order; `depth` is its length, so a depth cap is a predicate
   * rather than a traversal.
   */
  path  String
  depth Int    @default(0)

  authorPlayerId       String?
  authorPlayer         Player? @relation("BreakCommentAuthor", fields: [authorPlayerId], references: [id], onDelete: SetNull)
  authorNameSnapshot   String
  authorHandleSnapshot String?

  body     Json
  bodyText String

  score       Int @default(0)
  upvotes     Int @default(0)
  downvotes   Int @default(0)
  replyCount  Int @default(0)
  reportCount Int @default(0)

  /// Shown as speaking for the site. Staff only.
  distinguished Boolean @default(false)
  /// One stickied staff comment per post, held above normal sorting.
  sticky        Boolean @default(false)
  /// This branch accepts no new replies.
  locked        Boolean @default(false)
  spoiler       Boolean @default(false)
  sensitive     Boolean @default(false)
  muteReplies   Boolean @default(false)

  editedAt          DateTime?
  deletedAt         DateTime?
  removedAt         DateTime?
  removedByPlayerId String?
  removalReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media         BreakCommentMedia?
  votes         BreakCommentVote[]
  saves         BreakSavedComment[]
  reports       BreakReport[]
  notifications BreakNotification[]

  @@index([postId, path]) // the whole tree in display order
  @@index([postId, score]) // Top / Best
  @@index([postId, createdAt]) // New / Old
  @@index([parentId])
  @@index([authorPlayerId, createdAt])
  @@index([postId, sticky, score])
  @@map("break_comment")
}

/// At most one media item per comment — enforced by the unique commentId, not by the handler.
model BreakCommentMedia {
  id        Int          @id @default(autoincrement())
  commentId Int          @unique
  comment   BreakComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  kind           BreakMediaKind
  status         BreakMediaStatus @default(READY)
  url            String
  storageKey     String?
  mimeType       String
  bytes          Int              @default(0)
  width          Int?
  height         Int?
  duration       Float?
  posterUrl      String?
  alt            String?
  caption        String?
  sourceProvider String           @default("upload")
  sourceId       String?
  error          String?

  createdAt DateTime @default(now())

  @@map("break_comment_media")
}

/**
 * Votes.
 * `value` is +1 or -1 and never zero — removing a vote deletes the row, so "no vote" has exactly one
 * representation. The unique constraint is what makes one-vote-per-account true; the handler
 * enforcing it as well is belt and braces, not the mechanism.
 */
model BreakPostVote {
  id       Int       @id @default(autoincrement())
  postId   Int
  post     BreakPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  playerId String
  player   Player    @relation("BreakPostVoter", fields: [playerId], references: [id], onDelete: Cascade)
  value    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, playerId])
  @@index([playerId, createdAt])
  @@index([postId, value])
  @@map("break_post_vote")
}

model BreakCommentVote {
  id        Int          @id @default(autoincrement())
  commentId Int
  comment   BreakComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player       @relation("BreakCommentVoter", fields: [playerId], references: [id], onDelete: Cascade)
  value     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([commentId, playerId])
  @@index([playerId, createdAt])
  @@index([commentId, value])
  @@map("break_comment_vote")
}

model BreakSavedPost {
  playerId  String
  player    Player    @relation("BreakSavedPosts", fields: [playerId], references: [id], onDelete: Cascade)
  postId    Int
  post      BreakPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([playerId, postId])
  @@index([playerId, createdAt])
  @@map("break_saved_post")
}

model BreakSavedComment {
  playerId  String
  player    Player       @relation("BreakSavedComments", fields: [playerId], references: [id], onDelete: Cascade)
  commentId Int
  comment   BreakComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([playerId, commentId])
  @@index([playerId, createdAt])
  @@map("break_saved_comment")
}

/// Personal, private: hiding a post removes it from that member's feed and nobody else's.
model BreakHiddenPost {
  playerId  String
  player    Player    @relation("BreakHiddenPosts", fields: [playerId], references: [id], onDelete: Cascade)
  postId    Int
  post      BreakPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([playerId, postId])
  @@map("break_hidden_post")
}

/**
 * Reports.
 * One active report per account per target per reason, enforced by two partial unique indexes added
 * in the migration (Prisma cannot express a unique over a nullable pair cleanly). Reporters are
 * never shown to each other, and a report count alone never removes anything: only a moderator does.
 */
model BreakReport {
  id        Int           @id @default(autoincrement())
  postId    Int?
  post      BreakPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId Int?
  comment   BreakComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reporterPlayerId String?
  reporter         Player? @relation("BreakReporter", fields: [reporterPlayerId], references: [id], onDelete: SetNull)

  reason BreakReportReason
  detail String?
  status BreakReportStatus @default(OPEN)

  resolvedAt         DateTime?
  resolvedByPlayerId String?
  resolution         String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([postId])
  @@index([commentId])
  @@map("break_report")
}

/// Staff actions, written through the existing audit path as well. This table is what the moderation
/// history panel reads; the audit log is the tamper-evident record.
model BreakModerationAction {
  id            Int      @id @default(autoincrement())
  action        String
  postId        Int?
  commentId     Int?
  actorPlayerId String?
  actorName     String
  /// Shown to everyone, e.g. a removal reason.
  publicReason  String?
  /// Staff-only. Never rendered publicly and never included in a notification.
  note          String?
  detail        Json?
  createdAt     DateTime @default(now())

  @@index([postId, createdAt])
  @@index([commentId, createdAt])
  @@index([createdAt])
  @@map("break_moderation_action")
}

model BreakNotification {
  id                Int                   @id @default(autoincrement())
  recipientPlayerId String
  recipient         Player                @relation("BreakNotificationRecipient", fields: [recipientPlayerId], references: [id], onDelete: Cascade)
  kind              BreakNotificationKind

  postId    Int?
  post      BreakPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId Int?
  comment   BreakComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  actorPlayerId String?
  actorName     String?

  /// One row per (recipient, kind, target, actor). A reply that also mentions the same person is one
  /// notification, not two, and a re-edit does not produce another.
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientPlayerId, readAt, createdAt])
  @@map("break_notification")
}

/// Community participation totals, derived from received votes. Deliberately separate from Rating
/// and Rank, which are competition facts and must never mix with this.
model BreakKarma {
  playerId     String   @id
  player       Player   @relation("BreakKarma", fields: [playerId], references: [id], onDelete: Cascade)
  postKarma    Int      @default(0)
  commentKarma Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("break_karma")
}

/// A tally per post per day. No per-visitor rows and no addresses — enough to show a trend without
/// tracking anybody.
model BreakPostDailyView {
  id     Int       @id @default(autoincrement())
  postId Int
  post   BreakPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  day    DateTime  @db.Date
  views  Int       @default(0)

  @@unique([postId, day])
  @@index([day])
  @@map("break_post_daily_view")
}

/// Recent actions, for rate limiting. Holds an account id and an action name — no addresses, no
/// payloads. Pruned by the cleanup service.
model BreakActionLog {
  id         BigInt   @id @default(autoincrement())
  playerId   String?
  /// Hashed request signal for anonymous-adjacent limits. Never a raw address.
  clientHash String?
  action     String
  createdAt  DateTime @default(now())

  @@index([playerId, action, createdAt])
  @@index([clientHash, action, createdAt])
  @@index([createdAt])
  @@map("break_action_log")
}
