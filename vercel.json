{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/cueverse",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/site-builder-schedule",
      "schedule": "0 9 * * *"
    }
  ]
}
